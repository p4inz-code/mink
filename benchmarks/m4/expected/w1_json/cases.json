{
  "workload": "w1_json",
  "contract": "docs/benchmarks/M4/M4_SESSION_151.md",
  "notes": [
    "Declarative oracle: expected bytes are authored from the contract, not produced by running any implementation.",
    "stdout/stderr are UTF-8 bytes; \\r\\n is explicit so CRLF is compared byte-for-byte.",
    "{fixtures} is replaced with the absolute fixture directory by the harness.",
    "'scored' marks the ten cases in the M4 case budget; the rest are contract-required supporting cases and must also pass."
  ],
  "cases": [
    {
      "id": "validate_object",
      "scored": true,
      "argv": ["validate", "{fixtures}/object.json"],
      "exit": 0,
      "stdout": "ok\r\n",
      "stderr": ""
    },
    {
      "id": "type_object",
