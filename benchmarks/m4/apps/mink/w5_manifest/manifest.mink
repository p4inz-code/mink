// ============================================================================
// manifest — Validation milestone 1 / H: integrated application.
//
//   manifest <config.json>
//
// One realistic tool that combines four subsystems:
//   * JSON   — the config is parsed with the arena-based stdlib `json` module
//              (`root`, `out`, `extensions`);
//   * filesystem — the tree under `root` is walked recursively (directory
//              handles, `path_join`), with Unicode and space path segments;
//   * hashing — each selected file's content is hashed with `hash_sha256`;
//   * CSV    — the report is written with `csv_write_row` (RFC 4180 quoting,
//              LF terminators) so the artifact is byte-comparable.
//
// Report columns: `path,size,sha256,ext` where `sha256` is the first 16 hex
// characters of the digest. Paths are relative to `root` with `/` separators,
// sorted in byte order (equal to Python `str` order for UTF-8).
//
// Exit codes:
//   0  ok
//   1  usage error (missing/extra arguments, bad config types, any option)
//   2  config file missing / not a regular file
//   3  the config is not valid JSON / required keys missing
//   4  the root directory does not exist or the report cannot be written
//   5  no file matched the extensions
//
// Ownership: single-exit style. User functions consume `Str` parameters, the
// read-borrowing intrinsics get bound copies, and the JSON arena plus every
// owned string is released before exit.
// ============================================================================

mod csv;
mod filesystem;
mod hashing;
mod json;
mod strings;

fn fail_msg(label: Str) -> Int {
    let head = rt_str_concat("manifest: ", label);
    let line = rt_str_concat(head, "\r\n");
    rt_str_free(head);
    rt_str_free(label);
    let written = rt_stderr_write(line);
    rt_str_free(line);
    return written;
}

fn fail_file(label: Str, path: Str) -> Int {
    let head = rt_str_concat("manifest: ", label);
    let mid = rt_str_concat(head, path);
    rt_str_free(head);
    let line = rt_str_concat(mid, "\r\n");
    rt_str_free(mid);
    rt_str_free(label);
    rt_str_free(path);
    let written = rt_stderr_write(line);
    rt_str_free(line);
    return written;
}

// Print `<label><n>` on one line (rt_print_str appends the CRLF).
fn print_int(label: Str, n: Int) {
    let num = rt_str_from_int(n);
    let line = rt_str_concat(label, num);
    rt_str_free(num);
    rt_print_str(line);
    rt_str_free(line);
}

// Print `<label><value>` on one line. Consumes and frees both.
fn say(label: Str, value: Str) {
    let line = rt_str_concat(label, value);
    rt_print_str(line);
    rt_str_free(line);
    rt_str_free(label);
    rt_str_free(value);
}

fn lower(b: Int) -> Int {
    if b >= 65 { if b <= 90 { return b + 32; } }
    return b;
}

// Case-insensitive equality (consumes both arguments).
fn eq_ci(a: Str, b: Str) -> Bool {
    let la = rt_str_len(a);
    let lb = rt_str_len(b);
    let mut same = la == lb;
    if same == true {
        let mut i = 0;
        while i < la {
            if lower(rt_str_byte(a, i)) != lower(rt_str_byte(b, i)) { same = false; }
            i = i + 1;
        }
    }
    rt_str_free(a);
    rt_str_free(b);
    return same;
}

// True when `path`'s extension is one of the comma-separated `list` entries.
// Consumes both `path` and `list`.
fn ext_selected(path: Str, list: Str) -> Bool {
    let ext = path_extension(path);
    let ext_len = rt_str_len(ext);
    let list_len = rt_str_len(list);
    let mut hit = 0;
    if ext_len > 0 {
        let mut start = 0;
        let mut i = 0;
        while i < list_len {
            if rt_str_byte(list, i) == 44 { // ','
                if i > start {
                    let part = str_sub(rt_str_concat(list, ""), start, i);
                    if eq_ci(part, rt_str_concat(ext, "")) { hit = 1; }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        if start < list_len {
            let part = str_sub(rt_str_concat(list, ""), start, list_len);
            if eq_ci(part, rt_str_concat(ext, "")) { hit = 1; }
        }
    }
    rt_str_free(ext);
    rt_str_free(list);
    return hit == 1;
}

// Index of member `name` in object `obj`, or -1. Borrows `name`.
fn find_key(arena: Ptr<Int>, obj: Int, name: Str) -> Int {
    let n = json_obj_len(arena, obj);
    let mut found = -1;
    let mut i = 0;
    while i < n {
        let k = json_obj_get_key(arena, obj, i);
        let eq = rt_str_eq(k, name);
        rt_str_free(k);
        if eq == true { found = i; i = n; } else { i = i + 1; }
    }
    rt_str_free(name);
    return found;
}

// "<rel>/<name>" (or just `name` when `rel` is empty). Consumes both.
fn rel_child(rel: Str, name: Str) -> Str {
    let rl = rt_str_len(rel);
    // Bind `out` once per branch: the previous version overwrote the first
    // rt_str_concat result in the non-empty branch and leaked it.
    let mut out = "";
    if rl == 0 {
        out = rt_str_concat(name, "");
    } else {
        let a = rt_str_concat(rel, "/");
        out = rt_str_concat(a, name);
        rt_str_free(a);
    }
    rt_str_free(rel);
    rt_str_free(name);
    return out;
}

// Recursively collect selected files under `dir`, whose path relative to the
// reporting root is `rel`. Consumes `dir`, `rel` and `exts`; returns `out`.
fn walk(dir: Str, rel: Str, exts: Str, out) {
    let mut cur = out;
    let handle = fs_dir_open(rt_str_concat(dir, ""));
    if handle < 0 {
        fail_msg("cannot open directory");
        rt_str_free(dir);
        rt_str_free(rel);
        rt_str_free(exts);
        return cur;
    }

    let mut keep_going = 1;
    while keep_going == 1 {
        let name = fs_dir_next(handle);
        if rt_str_len(name) == 0 {
            rt_str_free(name);
            keep_going = 0;
        } else {
            let w = rt_str_concat(name, "");
            rt_str_free(name);
            if rt_str_eq(w, ".") {
                rt_str_free(w);
            } else {
                if rt_str_eq(w, "..") {
                    rt_str_free(w);
                } else {
                    let child_rel = rel_child(rt_str_concat(rel, ""), rt_str_concat(w, ""));
                    let full = path_join(rt_str_concat(dir, ""), rt_str_concat(w, ""));
                    if fs_is_dir(rt_str_concat(full, "")) {
                        cur = walk(rt_str_concat(full, ""), child_rel, rt_str_concat(exts, ""), cur);
                    } else {
                        if ext_selected(rt_str_concat(child_rel, ""), rt_str_concat(exts, "")) {
                            cur = rt_vec_push(cur, child_rel);
                        } else {
                            rt_str_free(child_rel);
                        }
                    }
                    rt_str_free(full);
                    rt_str_free(w);
                }
            }
        }
    }

    fs_dir_close(handle);
    rt_str_free(dir);
    rt_str_free(rel);
    rt_str_free(exts);
    return cur;
}

// Stable insertion sort of `Vec<Str>` by `str_cmp` (byte order).
fn sort_paths(v: Vec<Str>) -> Vec<Str> {
    let mut vv = v;
    let n = rt_vec_len(vv);
    let mut i = 1;
    while i < n {
        let key = rt_str_concat(rt_vec_get(vv, i), "");
        let mut j = i - 1;
        let mut done = 0;
        while done == 0 {
            if j < 0 {
                done = 1;
            } else {
                let other = rt_str_concat(rt_vec_get(vv, j), "");
                let cmp = str_cmp(other, rt_str_concat(key, ""));
                if cmp <= 0 { done = 1; } else {
                    let moved = rt_str_concat(rt_vec_get(vv, j), "");
                    vv = rt_vec_set(vv, j + 1, moved);
                    j = j - 1;
                }
            }
        }
        let copy = rt_str_concat(key, "");
        vv = rt_vec_set(vv, j + 1, copy);
        rt_str_free(key);
        i = i + 1;
    }
    return vv;
}

fn main() -> Int {
    let argc = rt_argc();

    let mut pos = rt_vec_new(4);
    let mut bad = 0;
    let mut i = 0;
    while i < argc {
        let arg = rt_argv(i);
        let mut optionish = 0;
        if rt_str_len(arg) > 0 {
            if rt_str_byte(arg, 0) == 45 { optionish = 1; }
        }
        if optionish == 1 {
            bad = 1;
            rt_str_free(arg);
        } else {
            pos = rt_vec_push(pos, arg);
        }
        i = i + 1;
    }

    let mut code = 1;
    let n = rt_vec_len(pos);
    if bad == 1 {
        fail_msg("this tool has no options");
        code = 1;
    } else if n != 1 {
        fail_msg("usage: manifest <config.json>");
        code = 1;
    } else {
        let cfg_path = rt_vec_get(pos, 0);
        if fs_exists(rt_str_concat(cfg_path, "")) == false {
            fail_file("config does not exist: ", rt_str_concat(cfg_path, ""));
            code = 2;
        } else if fs_is_file(rt_str_concat(cfg_path, "")) == false {
            fail_file("not a regular file: ", rt_str_concat(cfg_path, ""));
            code = 2;
        } else {
            let content = fs_read(rt_str_concat(cfg_path, ""));
            let arena = rt_alloc(65536);
            let cfg = json_parse(content, arena);
            if cfg == 0 {
                fail_msg("config is not valid JSON");
                code = 3;
            } else if json_tag(arena, cfg) != 5 {
                fail_msg("config must be a JSON object");
                code = 3;
            } else {
                let root_idx = find_key(arena, cfg, rt_str_concat("root", ""));
                let out_idx = find_key(arena, cfg, rt_str_concat("out", ""));
                let ext_idx = find_key(arena, cfg, rt_str_concat("extensions", ""));
                if root_idx < 0 || out_idx < 0 || ext_idx < 0 {
                    fail_msg("config needs root, out and extensions");
                    code = 3;
                } else {
                    let root_val = json_obj_get_val(arena, cfg, root_idx);
                    let out_val = json_obj_get_val(arena, cfg, out_idx);
                    let ext_val = json_obj_get_val(arena, cfg, ext_idx);
                    if json_tag(arena, root_val) != 3 || json_tag(arena, out_val) != 3 || json_tag(arena, ext_val) != 4 {
                        fail_msg("config types must be string, string, array");
                        code = 3;
                    } else {
                        let root = json_as_str(arena, root_val);
                        let out = json_as_str(arena, out_val);
                        // Join the extension array into one comma list.
                        let en = json_arr_len(arena, ext_val);
                        let mut exts = rt_str_concat("", "");
                        let mut e = 0;
                        while e < en {
                            let el = json_arr_get(arena, ext_val, e);
                            if json_tag(arena, el) == 3 {
                                let part = json_as_str(arena, el);
                                let a = rt_str_concat(exts, part);
                                rt_str_free(exts);
                                rt_str_free(part);
                                exts = a;
                                if e + 1 < en {
                                    let b = rt_str_concat(exts, ",");
                                    rt_str_free(exts);
                                    exts = b;
                                }
                            }
                            e = e + 1;
                        }
                        if fs_exists(rt_str_concat(root, "")) == false {
                            fail_file("root does not exist: ", rt_str_concat(root, ""));
                            rt_str_free(root);
                            rt_str_free(out);
                            rt_str_free(exts);
                            code = 4;
                        } else {
                            let mut files = rt_vec_new(16);
                            files = walk(rt_str_concat(root, ""), rt_str_concat("", ""), rt_str_concat(exts, ""), files);
                            files = sort_paths(files);
                            let count = rt_vec_len(files);
                            if count == 0 {
                                fail_msg("no file matched the extensions");
                                rt_vec_free(files);
                                rt_str_free(root);
                                rt_str_free(out);
                                rt_str_free(exts);
                                code = 5;
                            } else {
                                let mut parts = rt_vec_new(count + 1);
                                let mut header = rt_vec_new(4);
                                header = rt_vec_push(header, rt_str_concat("path", ""));
                                header = rt_vec_push(header, rt_str_concat("size", ""));
                                header = rt_vec_push(header, rt_str_concat("sha256", ""));
                                header = rt_vec_push(header, rt_str_concat("ext", ""));
                                parts = rt_vec_push(parts, csv_write_row(header));
                                rt_vec_free(header);

                                let mut total_bytes = 0;
                                let mut k = 0;
                                while k < count {
                                    let rel = rt_str_concat(rt_vec_get(files, k), "");
                                    let full = path_join(rt_str_concat(root, ""), rt_str_concat(rel, ""));
                                    let size = fs_file_size(rt_str_concat(full, ""));
                                    total_bytes = total_bytes + size;
                                    let data = fs_read(rt_str_concat(full, ""));
                                    let digest = hash_sha256(data);
                                    let short = str_sub(rt_str_concat(digest, ""), 0, 16);
                                    rt_str_free(digest);
                                    let ext = path_extension(rt_str_concat(full, ""));
                                    let mut row = rt_vec_new(4);
                                    row = rt_vec_push(row, rt_str_concat(rel, ""));
                                    row = rt_vec_push(row, rt_str_from_int(size));
                                    row = rt_vec_push(row, rt_str_concat(short, ""));
                                    row = rt_vec_push(row, rt_str_concat(ext, ""));
                                    parts = rt_vec_push(parts, csv_write_row(row));
                                    rt_vec_free(row);
                                    rt_str_free(short);
                                    rt_str_free(ext);
                                    rt_str_free(full);
                                    rt_str_free(rel);
                                    k = k + 1;
                                }
                                let body = str_join(parts, "\n");
                                let final = rt_str_concat(body, "\n");
                                rt_str_free(body);
                                let wrote = fs_write(rt_str_concat(out, ""), final);
                                if wrote < 0 {
                                    fail_file("cannot write report: ", rt_str_concat(out, ""));
                                    code = 4;
                                } else {
                                    print_int("files=", count);
                                    print_int("bytes=", total_bytes);
                                    say("first=", rt_str_concat(rt_vec_get(files, 0), ""));
                                    code = 0;
                                }
                                rt_vec_free(files);
                                rt_str_free(root);
                                rt_str_free(out);
                                rt_str_free(exts);
                            }
                        }
                    }
                }
            }
            rt_free(arena);
        }
    }

    rt_vec_free(pos);
    return code;
}
