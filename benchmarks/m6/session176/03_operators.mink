fn main() {
    let a = 7;
    let b = 3;

    rt_print_int(a + b);
    rt_print_int(a - b);
    rt_print_int(a * b);
    rt_print_int(a / b);
    rt_print_int(a % b);
    rt_print_int(a << 1);
    rt_print_int(a & b);

    if a > b && b > 0 {
        rt_print_int(1);
    } else {
        rt_print_int(0);
    }
    if a == 7 || b == 99 {
        rt_print_int(1);
    } else {
        rt_print_int(0);
    }
    return 0;
}
