// Resource-style cleanup with a real runtime lock. The defer owns the
// unlock/free pair, so both the early-return and normal-return paths release
// the mutex exactly once.

fn use_lock(early: Bool) -> Int {
    let lock = rt_mutex_new();
    rt_mutex_lock(lock);

    defer {
        rt_mutex_unlock(lock);
        rt_mutex_free(lock);
        rt_print_str("released");
    }

    rt_print_str("locked");
    if early {
        rt_print_str("early-return");
        return 7;
    }

    rt_print_str("normal-return");
    return 3;
}

fn main() -> Int {
    let early = use_lock(true);
    let normal = use_lock(false);

    rt_print_int(early);
    rt_print_int(normal);

    if early != 7 || normal != 3 {
        rt_print_str("FAIL: unexpected result");
        return 1;
    }
    return 0;
}
