// ============================================================================
// MINK Regex Tool — count pattern matches in piped input.
//
// Demonstrates the standard-library regular-expression module end to end
// through the public language interface:
//
//   - `mod re; use re::re_count;` (stdlib module resolution)
//   - command-line arguments (`rt_argc`, `rt_argv`)
//   - piped stdin (`rt_stdin_read`)
//   - a regex query that returns the subject back (ownership pass-back idiom)
//
// Build and run:
//   mink build examples/regex_tool/main.mink
//   type some text | examples/regex_tool/main.exe "\d+"
//
// The program prints the number of non-overlapping matches on stdout and
// exits 0; usage errors exit 2.
// ============================================================================

mod re;
use re::re_count;

fn main() -> Int {
    let argc = rt_argc();
    if argc < 1 {
        rt_stderr_write("usage: regex_tool <pattern>  (text is read from stdin)\n");
        return 2;
    }
    let pattern = rt_argv(0);
    let text = rt_stdin_read();
    let r = re_count(pattern, text);
    rt_print_str("matches: ");
    rt_print_int(r.0);
    rt_str_free(r.1);
    return 0;
}
