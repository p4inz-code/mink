// ============================================================================
// MINK TCP Client — connect to a local echo server and verify the round trip.
//
// Usage: tcp_client.exe <port>
// Connects to 127.0.0.1:<port>, sends a 32-byte payload, reads the echo back,
// and verifies it matches. Exercises Winsock init, socket, connect, send,
// recv, close, cleanup. Self-contained (runtime intrinsics only).
// ============================================================================

fn main() -> Int {
    if rt_argc() < 1 { rt_print_str("usage: tcp_client.exe <port>"); return 1; }
    let arg = rt_argv(0);
    let mut port = 0;
    let mut pi = 0;
    let arglen = rt_str_len(arg);
    while pi < arglen {
        let c = rt_str_byte(arg, pi);
        if c < 48 || c > 57 { port = 0; pi = arglen; }
        else { port = port * 10 + (c - 48); }
        pi = pi + 1;
    }
    rt_str_free(arg);
    if port <= 0 { rt_print_str("usage: tcp_client.exe <port>"); return 1; }

    let r = rt_net_wsa_startup();
    if r != 0 { rt_print_str("FAIL: wsa startup"); return 2; }

    let sock = rt_net_socket(2, 1, 6); // AF_INET, SOCK_STREAM, TCP
    if sock == -1 { rt_print_str("FAIL: socket"); rt_net_wsa_cleanup(); return 3; }

    let c = rt_net_connect(sock, "127.0.0.1", port);
    if c != 0 { rt_print_str("FAIL: connect"); rt_net_close(sock); rt_net_wsa_cleanup(); return 4; }

    // Build a 32-byte payload.
    let msg = rt_str_alloc(32);
    let mut i = 0;
    while i < 32 {
        rt_str_set_byte(msg, i, 65 + i % 26);
        i = i + 1;
    }

    let sent = rt_net_send(sock, msg);
    if sent != 32 { rt_print_str("FAIL: send"); rt_net_close(sock); rt_net_wsa_cleanup(); return 5; }

    let got = rt_net_recv(sock, 4096);
    let glen = rt_str_len(got);
    if glen != 32 { rt_print_str("FAIL: recv len"); rt_net_close(sock); rt_net_wsa_cleanup(); return 6; }

    let mut ok = true;
    i = 0;
    while i < 32 {
        if rt_str_byte(got, i) != rt_str_byte(msg, i) { ok = false; }
        i = i + 1;
    }
    if !ok { rt_print_str("FAIL: echo mismatch"); rt_net_close(sock); rt_net_wsa_cleanup(); return 7; }

    rt_str_free(got);
    rt_str_free(msg);
    rt_net_close(sock);
    rt_net_wsa_cleanup();
    rt_print_str("tcp-ok");
    return 0;
}