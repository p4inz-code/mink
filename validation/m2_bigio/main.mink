// ============================================================================
// bigio — Milestone 2 / A: large data and file workloads.
//
//   bigio gen   <path> <mib> <pattern>   write <mib> MiB of a repeated pattern
//   bigio scan  <path>                   size, line count, digit checksum, sha256
//   bigio copy  <src> <dst>              copy a file, verify both hashes
//   bigio stdin                          read stdin to EOF, same statistics
//   bigio grow  <steps>                  double a string `steps` times
//   bigio cycles <n>                     allocate/free churn (leak-checked)
//   bigio json  <path> <field>           parse a large JSON array and sum a field
//   bigio clean <path>                   delete a file
//
// Exit codes:
//   0  ok
//   1  usage error (unknown command, bad number, any option)
//   2  file missing / not a regular file / unreadable
//   3  the JSON document is invalid or has the wrong shape
// ============================================================================

mod filesystem;
mod strings;
mod hashing;
mod json;

fn fail_msg(label: Str) -> Int {
    let head = rt_str_concat("bigio: ", label);
    let line = rt_str_concat(head, "\r\n");
    rt_str_free(head);
    rt_str_free(label);
    let written = rt_stderr_write(line);
    rt_str_free(line);
    return written;
}

fn say(label: Str, value: Str) {
    let line = rt_str_concat(label, value);
    rt_print_str(line);
    rt_str_free(line);
    rt_str_free(label);
    rt_str_free(value);
}

fn say_int(label: Str, value: Int) {
    say(label, rt_str_from_int(value));
}

// Consumes `path`; returns an owned content string (empty on error).
fn load(path: Str) -> (Str, Int) {
    if fs_exists(rt_str_concat(path, "")) == false {
        fail_msg("file does not exist");
        rt_str_free(path);
        return (rt_str_alloc(0), 2);
    }
    if fs_is_file(rt_str_concat(path, "")) == false {
        fail_msg("not a regular file");
        rt_str_free(path);
        return (rt_str_alloc(0), 2);
    }
    let content = fs_read(rt_str_concat(path, ""));
    rt_str_free(path);
    return (content, 0);
}

// Bytes, LF count, digit checksum and SHA-256 of `s`. Consumes `s`.
fn report_bytes(s: Str) -> Int {
    let n = rt_str_len(s);
    let mut lines = 0;
    let mut digits = 0;
    let mut i = 0;
    while i < n {
        let b = rt_str_byte(s, i);
        if b == 10 { lines = lines + 1; }
        if b >= 48 && b <= 57 { digits = (digits + (b - 48)) % 1000003; }
        i = i + 1;
    }
    say_int("bytes=", n);
    say_int("lines=", lines);
    say_int("digits=", digits);
    let copy = rt_str_concat(s, "");
    let h = hash_sha256(copy);
    say("sha256=", h);
    rt_str_free(s);
    return 0;
}

// ---------------------------------------------------------------------------
// gen: build `mib` MiB from `pattern` without quadratic copying.
// ---------------------------------------------------------------------------
fn cmd_gen(path: Str, mib: Int, pattern: Str) -> Int {
    let target = mib * 1024 * 1024;
    let plen = rt_str_len(pattern);
    if plen == 0 || target <= 0 {
        fail_msg("usage: bigio gen <path> <mib> <pattern>");
        rt_str_free(path);
        rt_str_free(pattern);
        return 1;
    }
    let mut chunk = rt_str_concat(pattern, "");
    rt_str_free(pattern);
    // Double the chunk until it covers a whole MiB, then pad to exact size.
    while rt_str_len(chunk) < 1048576 {
        let copy = rt_str_concat(chunk, "");
        let next = rt_str_concat(chunk, copy);
        rt_str_free(copy);
        rt_str_free(chunk);
        chunk = next;
    }
    let unit = str_sub(rt_str_concat(chunk, ""), 0, 1048576);
    rt_str_free(chunk);

    let mut body = rt_str_alloc(target);
    let mut off = 0;
    while off < target {
        let mut j = 0;
        while j < 1048576 && off + j < target {
            rt_str_set_byte(body, off + j, rt_str_byte(unit, j));
            j = j + 1;
        }
        off = off + 1048576;
    }
    rt_str_free(unit);
    let written = fs_write(rt_str_concat(path, ""), body);
    let size = fs_file_size(rt_str_concat(path, ""));
    rt_str_free(path);
    say_int("wrote=", written);
    say_int("size=", size);
    return 0;
}

fn cmd_scan(path: Str) -> Int {
    let (content, status) = load(path);
    if status != 0 {
        rt_str_free(content);
        return status;
    }
    return report_bytes(content);
}

fn cmd_copy(src: Str, dst: Str) -> Int {
    let (content, status) = load(rt_str_concat(src, ""));
    rt_str_free(src);
    if status != 0 {
        rt_str_free(content);
        rt_str_free(dst);
        return status;
    }
    let written = fs_write(rt_str_concat(dst, ""), content);
    say_int("wrote=", written);
    say_int("size=", fs_file_size(rt_str_concat(dst, "")));
    let back = fs_read(rt_str_concat(dst, ""));
    let h = hash_sha256(back);
    say("dst-sha256=", h);
    rt_str_free(dst);
    return 0;
}

fn cmd_stdin() -> Int {
    let data = rt_stdin_read();
    return report_bytes(data);
}

// Repeated growth: an owned string that doubles `steps` times.
fn cmd_grow(steps: Int) -> Int {
    if steps <= 0 || steps > 24 {
        fail_msg("usage: bigio grow <1..24>");
        return 1;
    }
    let mut s = rt_str_concat("0123456789abcdef", "");
    let mut k = 0;
    while k < steps {
        let copy = rt_str_concat(s, "");
        let next = rt_str_concat(s, copy);
        rt_str_free(copy);
        rt_str_free(s);
        s = next;
        k = k + 1;
    }
    say_int("len=", rt_str_len(s));
    let h = hash_sha256(s);
    say("sha256=", h);
    return 0;
}

// Allocate/free churn: Str and raw blocks, so the live table is recycled.
fn cmd_cycles(n: Int) -> Int {
    if n <= 0 || n > 200000 {
        fail_msg("usage: bigio cycles <1..200000>");
        return 1;
    }
    let mut i = 0;
    let mut checksum = 0;
    while i < n {
        // One size class only: 64 KiB built, touched and freed. (Mixing a
        // second size class in this loop hits the free-list limitation
        // documented in docs/validation/VALIDATION_MILESTONE_2_REPORT.md —
        // see churn_repro.mink.)
        let s = str_repeat("0123456789abcdef", 4096); // 64 KiB
        checksum = (checksum + rt_str_byte(s, i % 65536)) % 1000003;
        rt_str_free(s);
        i = i + 1;
    }
    say_int("cycles=", n);
    say_int("checksum=", checksum);
    return 0;
}

// Parse a JSON array of objects; sum one integer field.
fn cmd_json(path: Str, field: Str) -> Int {
    let (content, status) = load(path);
    if status != 0 {
        rt_str_free(content);
        rt_str_free(field);
        return status;
    }
    let len = rt_str_len(content);
    // 8 bytes per slot: input bytes + the parsed tree + output headroom.
    let slots = len * 4 + 64;
    let arena = rt_alloc(slots * 8);
    let v = json_parse_in(content, arena, slots);
    if v == 0 {
        rt_free(arena);
        rt_str_free(field);
        fail_msg("invalid JSON document");
        return 3;
    }
    if json_tag(arena, v) != 4 {
        rt_free(arena);
        rt_str_free(field);
        fail_msg("root value is not an array");
        return 3;
    }
    let n = json_arr_len(arena, v);
    let field_copy = rt_str_concat(field, "");
    let mut total = 0;
    let mut found = 0;
    let mut i = 0;
    while i < n {
        let obj = json_arr_get(arena, v, i);
        if json_tag(arena, obj) == 5 {
            let members = json_obj_len(arena, obj);
            let mut j = 0;
            while j < members {
                let key = json_obj_get_key(arena, obj, j);
                if rt_str_eq(key, field_copy) == true {
                    found = found + 1;
                    total = total + json_as_int(arena, json_obj_get_val(arena, obj, j));
                }
                rt_str_free(key);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    say_int("records=", n);
    say_int("matches=", found);
    say_int("sum=", total);
    rt_free(arena);
    rt_str_free(field_copy);
    rt_str_free(field);
    return 0;
}

fn cmd_clean(path: Str) -> Int {
    if fs_exists(rt_str_concat(path, "")) == false {
        fail_msg("file does not exist");
        rt_str_free(path);
        return 2;
    }
    let r = fs_remove_file(rt_str_concat(path, ""));
    rt_str_free(path);
    say_int("removed=", r);
    return 0;
}

// Consumes the copy it is given.
fn optionish(s: Str) -> Bool {
    let n = rt_str_len(s);
    let mut dash = false;
    if n > 0 {
        if rt_str_byte(s, 0) == 45 { dash = true; }
    }
    rt_str_free(s);
    return dash;
}

// `s` is an owned copy: str_parse_int consumes it.
fn parse_num(s: Str, fallback: Int) -> Int {
    let (v, ok) = str_parse_int(s);
    if ok == false { return fallback; }
    return v;
}

// A command argument is a copy, so the command may consume it and the
// argument vector keeps ownership of the original until rt_vec_free.
fn arg_copy(pos: Vec<Str>, i: Int) -> Str {
    return rt_str_concat(rt_vec_get(pos, i), "");
}

fn main() -> Int {
    let argc = rt_argc();
    let mut pos = rt_vec_new(8);
    let mut bad = 0;
    let mut i = 0;
    while i < argc {
        let arg = rt_argv(i);
        if optionish(rt_str_concat(arg, "")) == true {
            bad = 1;
            rt_str_free(arg);
        } else {
            pos = rt_vec_push(pos, arg);
        }
        i = i + 1;
    }

    let mut code = 1;
    let n = rt_vec_len(pos);
    if bad == 1 {
        fail_msg("this tool has no options");
    } else if n == 0 {
        fail_msg("usage: bigio <gen|scan|copy|stdin|grow|cycles|json|clean> ...");
    } else {
        let cmd = rt_vec_get(pos, 0);
        if rt_str_eq(cmd, "gen") == true {
            if n != 4 {
                fail_msg("usage: bigio gen <path> <mib> <pattern>");
            } else {
                code = cmd_gen(arg_copy(pos, 1), parse_num(arg_copy(pos, 2), 0),
                               arg_copy(pos, 3));
            }
        } else if rt_str_eq(cmd, "scan") == true {
            if n != 2 {
                fail_msg("usage: bigio scan <path>");
            } else {
                code = cmd_scan(arg_copy(pos, 1));
            }
        } else if rt_str_eq(cmd, "copy") == true {
            if n != 3 {
                fail_msg("usage: bigio copy <src> <dst>");
            } else {
                code = cmd_copy(arg_copy(pos, 1), arg_copy(pos, 2));
            }
        } else if rt_str_eq(cmd, "stdin") == true {
            if n != 1 {
                fail_msg("usage: bigio stdin");
            } else {
                code = cmd_stdin();
            }
        } else if rt_str_eq(cmd, "grow") == true {
            if n != 2 {
                fail_msg("usage: bigio grow <1..24>");
            } else {
                code = cmd_grow(parse_num(arg_copy(pos, 1), 0));
            }
        } else if rt_str_eq(cmd, "cycles") == true {
            if n != 2 {
                fail_msg("usage: bigio cycles <1..200000>");
            } else {
                code = cmd_cycles(parse_num(arg_copy(pos, 1), 0));
            }
        } else if rt_str_eq(cmd, "json") == true {
            if n != 3 {
                fail_msg("usage: bigio json <path> <field>");
            } else {
                code = cmd_json(arg_copy(pos, 1), arg_copy(pos, 2));
            }
        } else if rt_str_eq(cmd, "clean") == true {
            if n != 2 {
                fail_msg("usage: bigio clean <path>");
            } else {
                code = cmd_clean(arg_copy(pos, 1));
            }
        } else {
            fail_msg("unknown command");
        }
    }

    rt_vec_free(pos);
    return code;
}
