// ============================================================================
// csvdata — Validation milestone 1 / B: CSV / data processing.
//
//   csvdata <command> <file> [args]
//     select <file> <col> <substr>          rows whose field contains substr
//     sort   <file> <col>                   rows sorted by field (stable)
//     agg    <file> <group-col> <value-col> group by field, sum integer field
//     write  <file> <out>                   re-serialize the CSV to <out>
//
// The first record is the header. Record splitting is an RFC 4180 state
// machine over the raw bytes (CR / LF / CRLF terminators outside quotes are
// record boundaries; a newline inside a quoted field is data), then each
// record is decoded with the stdlib `csv_parse_row` and re-encoded with
// `csv_write_row`, so the tool exercises parse and write, not just copy.
// Blank lines (zero fields) are skipped. A row with a different field count
// than the header is a ragged-row error (exit 4).
//
// Exit codes:
//   0  ok
//   1  usage error (unknown command, missing/extra arguments, bad column)
//   2  input file missing or not a regular file
//   3  no data rows (or nothing selected / nothing to write)
//   4  ragged row (field count differs from the header)
//   5  output file could not be written
//
// Ownership: single-exit style; every binding is released exactly once;
// consuming user functions receive intrinsic copies (`rt_str_concat(x, "")`)
// unless the transfer is intended (Vec parameters are passed by value and are
// NOT consumed, so the caller frees them).
// ============================================================================

mod filesystem;
mod strings;
mod csv;

fn fail_msg(label: Str) -> Int {
    let head = rt_str_concat("csvdata: ", label);
    let line = rt_str_concat(head, "\r\n");
    rt_str_free(head);
    rt_str_free(label);
    let written = rt_stderr_write(line);
    rt_str_free(line);
    return written;
}

fn fail_file(label: Str, path: Str) -> Int {
    let head = rt_str_concat("csvdata: ", label);
    let mid = rt_str_concat(head, path);
    rt_str_free(head);
    let line = rt_str_concat(mid, "\r\n");
    rt_str_free(mid);
    rt_str_free(label);
    rt_str_free(path);
    let written = rt_stderr_write(line);
    rt_str_free(line);
    return written;
}

// Split the raw document into record strings on CR / LF / CRLF outside
// quoted fields. Consumes `content`; returns an owned Vec<Str>.
fn split_records(content: Str) -> Vec<Str> {
    let n = rt_str_len(content);
    let mut out = rt_vec_new(16);
    let mut start = 0;
    let mut i = 0;
    let mut inq = 0;
    while i < n {
        let b = rt_str_byte(content, i);
        if inq == 1 {
            if b == 34 {
                let mut nxt = -1;
                if i + 1 < n { nxt = rt_str_byte(content, i + 1); }
                if nxt == 34 { i = i + 1; } else { inq = 0; }
            }
        } else {
            if b == 34 {
                inq = 1;
            } else if b == 10 {
                let rec = str_sub(rt_str_concat(content, ""), start, i);
                out = rt_vec_push(out, rec);
                start = i + 1;
            } else if b == 13 {
                let rec = str_sub(rt_str_concat(content, ""), start, i);
                out = rt_vec_push(out, rec);
                if i + 1 < n {
                    if rt_str_byte(content, i + 1) == 10 { i = i + 1; }
                }
                start = i + 1;
            } else {
                // ordinary byte
            }
        }
        i = i + 1;
    }
    if start < n {
        let rec = str_sub(rt_str_concat(content, ""), start, n);
        out = rt_vec_push(out, rec);
    }
    rt_str_free(content);
    return out;
}

// Parse `file` into a flat field vector. The first non-blank record is the
// header and defines the column count; blank records are skipped. Returns
// (fields, cols, rows, status) where:
//   status 0 ok, 2 file error (message printed), 4 ragged (message printed).
// `rows` includes the header row; field (row, col) is fields[row*cols + col].
// Consumes `file`.
fn load_rows(file: Str) -> (Vec<Str>, Int, Int, Int) {
    let mut fields = rt_vec_new(64);
    let mut cols = 0;
    let mut rows = 0;
    let mut status = 0;

    let probe = rt_str_concat(file, "");
    let exists = rt_fs_exists(probe);
    rt_str_free(probe);
    if exists == false {
        fail_file("input file does not exist: ", rt_str_concat(file, ""));
        status = 2;
    } else {
        if fs_is_file(rt_str_concat(file, "")) == false {
            fail_file("not a regular file: ", rt_str_concat(file, ""));
            status = 2;
        } else {
            let content = fs_read(rt_str_concat(file, ""));
            let records = split_records(content);
            let nrec = rt_vec_len(records);
            let mut idx = 0;
            while idx < nrec {
                let row = csv_parse_row(rt_str_concat(rt_vec_get(records, idx), ""));
                let fc = rt_vec_len(row);
                if fc == 0 {
                    // blank line: skipped
                } else {
                    if rows == 0 {
                        cols = fc;
                    } else {
                        if fc != cols { status = 4; }
                    }
                    let mut j = 0;
                    while j < fc {
                        fields = rt_vec_push(fields, rt_str_concat(rt_vec_get(row, j), ""));
                        j = j + 1;
                    }
                    rows = rows + 1;
                }
                rt_vec_free(row);
                idx = idx + 1;
            }
            rt_vec_free(records);
        }
    }
    rt_str_free(file);
    return (fields, cols, rows, status);
}

// A fresh Vec<Str> holding a copy of row `r`'s fields.
fn row_vec(fields: Vec<Str>, row: Int, cols: Int) -> Vec<Str> {
    let mut v = rt_vec_new(cols);
    let mut j = 0;
    while j < cols {
        v = rt_vec_push(v, rt_str_concat(rt_vec_get(fields, row * cols + j), ""));
        j = j + 1;
    }
    return v;
}

// Print one row re-encoded with `csv_write_row` plus CRLF (rt_print_str).
fn print_row(fields: Vec<Str>, row: Int, cols: Int) -> Int {
    let v = row_vec(fields, row, cols);
    let text = csv_write_row(v);
    rt_vec_free(v);
    rt_print_str(text);
    rt_str_free(text);
    return 0;
}

// select: print every data row whose field `col` contains `needle`.
// Consumes `needle`.
fn cmd_select(fields: Vec<Str>, cols: Int, rows: Int, col: Int, needle: Str) -> Int {
    let mut found = 0;
    let mut r = 1;
    while r < rows {
        let cell = rt_vec_get(fields, r * cols + col);
        let (hit, back) = str_contains(rt_str_concat(cell, ""), rt_str_concat(needle, ""));
        rt_str_free(back);
        if hit == true {
            print_row(fields, r, cols);
            found = found + 1;
        }
        r = r + 1;
    }
    rt_str_free(needle);
    let mut code = 3;
    if found > 0 { code = 0; }
    return code;
}

// sort: stable insertion sort of the data row indices by field `col`
// (byte order, which equals Python's str ordering for ASCII).
fn cmd_sort(fields: Vec<Str>, cols: Int, rows: Int, col: Int) -> Int {
    let mut order = rt_vec_new(rows);
    let mut r = 1;
    while r < rows {
        order = rt_vec_push(order, r);
        r = r + 1;
    }
    let n = rt_vec_len(order);
    let mut i = 1;
    while i < n {
        let key_idx = rt_vec_get(order, i);
        let key = rt_str_concat(rt_vec_get(fields, key_idx * cols + col), "");
        let mut j = i - 1;
        let mut done = 0;
        while done == 0 {
            if j < 0 {
                done = 1;
            } else {
                let other = rt_str_concat(rt_vec_get(fields, rt_vec_get(order, j) * cols + col), "");
                let cmp = str_cmp(other, rt_str_concat(key, ""));
                if cmp <= 0 { done = 1; } else {
                    order = rt_vec_set(order, j + 1, rt_vec_get(order, j));
                    j = j - 1;
                }
            }
        }
        order = rt_vec_set(order, j + 1, key_idx);
        rt_str_free(key);
        i = i + 1;
    }
    let mut k = 0;
    while k < n {
        print_row(fields, rt_vec_get(order, k), cols);
        k = k + 1;
    }
    rt_vec_free(order);
    return 0;
}

// agg: group the data rows by field `gcol`, summing the integer field `vcol`
// (a non-integer value contributes 0), then print "<key>:<sum>" per group in
// ascending key order.
fn cmd_agg(fields: Vec<Str>, cols: Int, rows: Int, gcol: Int, vcol: Int) -> Int {
    let mut agg = rt_map_new(16);
    let mut r = 1;
    while r < rows {
        let key = rt_str_concat(rt_vec_get(fields, r * cols + gcol), "");
        let vtext = rt_str_concat(rt_vec_get(fields, r * cols + vcol), "");
        let (v, ok) = str_parse_int(vtext);
        let mut add = 0;
        if ok == true { add = v; }
        let mut total = add;
        // rt_map_has / rt_map_get are read-borrowing: the probe copy must be
        // bound and released (or the run ends with E-R06).
        let has_copy = rt_str_concat(key, "");
        if rt_map_has(agg, has_copy) == true {
            let get_copy = rt_str_concat(key, "");
            total = rt_map_get(agg, get_copy) + add;
            rt_str_free(get_copy);
        }
        rt_str_free(has_copy);
        agg = rt_map_insert(agg, key, total);
        r = r + 1;
    }
    let mut keys = rt_map_keys(agg);
    let n = rt_vec_len(keys);
    let mut i = 1;
    while i < n {
        let key = rt_str_concat(rt_vec_get(keys, i), "");
        let mut j = i - 1;
        let mut done = 0;
        while done == 0 {
            if j < 0 {
                done = 1;
            } else {
                let other = rt_str_concat(rt_vec_get(keys, j), "");
                let cmp = str_cmp(other, rt_str_concat(key, ""));
                if cmp <= 0 { done = 1; } else {
                    keys = rt_vec_set(keys, j + 1, rt_str_concat(rt_vec_get(keys, j), ""));
                    j = j - 1;
                }
            }
        }
        keys = rt_vec_set(keys, j + 1, key);
        i = i + 1;
    }
    let mut k = 0;
    while k < n {
        let key = rt_str_concat(rt_vec_get(keys, k), "");
        let get_copy = rt_str_concat(key, "");
        let total = rt_map_get(agg, get_copy);
        rt_str_free(get_copy);
        let num = rt_str_from_int(total);
        let head = rt_str_concat(key, ":");
        let line = rt_str_concat(head, num);
        rt_str_free(head);
        rt_str_free(num);
        // rt_str_concat is read-borrowing: `key` was copied into `head`.
        rt_str_free(key);
        rt_print_str(line);
        rt_str_free(line);
        k = k + 1;
    }
    rt_vec_free(keys);
    rt_map_free(agg);
    let mut code = 3;
    if n > 0 { code = 0; }
    return code;
}

// write: re-serialize header + data rows (CRLF-terminated) into the output
// path held in `pos` at `out_index` (Vec parameters are not consumed).
fn cmd_write(fields: Vec<Str>, cols: Int, rows: Int, pos: Vec<Str>, out_index: Int) -> Int {
    let mut parts = rt_vec_new(rows);
    let mut r = 0;
    while r < rows {
        let v = row_vec(fields, r, cols);
        let text = csv_write_row(v);
        rt_vec_free(v);
        parts = rt_vec_push(parts, text);
        r = r + 1;
    }
    let body = str_join(parts, "\r\n");
    let final = rt_str_concat(body, "\r\n");
    rt_str_free(body);
    let wrote = fs_write(rt_str_concat(rt_vec_get(pos, out_index), ""), final);
    let mut code = 0;
    if wrote < 0 {
        fail_file("cannot write output file: ", rt_str_concat(rt_vec_get(pos, out_index), ""));
        code = 5;
    }
    return code;
}

fn main() -> Int {
    let argc = rt_argc();

    let mut pos = rt_vec_new(4);
    let mut bad = 0;
    let mut i = 0;
    while i < argc {
        let arg = rt_argv(i);
        let mut optionish = 0;
        if rt_str_len(arg) > 0 {
            if rt_str_byte(arg, 0) == 45 { optionish = 1; }
        }
        if optionish == 1 {
            bad = 1;
            rt_str_free(arg);
        } else {
            pos = rt_vec_push(pos, arg);
        }
        i = i + 1;
    }

    let mut code = 1;
    let n = rt_vec_len(pos);
    if bad == 1 {
        fail_msg("this tool has no options");
    } else if n < 2 {
        fail_msg("usage: csvdata <select|sort|agg|write> <file> [args]");
    } else {
        let cmd = rt_vec_get(pos, 0);
        if rt_str_eq(cmd, "select") {
            if n != 4 {
                fail_msg("usage: csvdata select <file> <col> <substr>");
            } else {
                let (col, cok) = str_parse_int(rt_str_concat(rt_vec_get(pos, 2), ""));
                if cok == false {
                    fail_msg("column index must be an integer");
                } else if col < 0 {
                    fail_msg("column index must not be negative");
                } else {
                    let (fields, cols, rows, status) = load_rows(rt_str_concat(rt_vec_get(pos, 1), ""));
                    if status == 2 { code = 2; } else {
                        if status == 4 {
                            fail_msg("ragged row: field count differs from the header");
                            code = 4;
                        } else {
                            if col >= cols {
                                fail_file("column out of range for: ", rt_str_concat(rt_vec_get(pos, 1), ""));
                                code = 4;
                            } else {
                                if rows <= 1 { code = 3; } else {
                                    code = cmd_select(fields, cols, rows, col, rt_str_concat(rt_vec_get(pos, 3), ""));
                                }
                            }
                        }
                    }
                    rt_vec_free(fields);
                }
            }
        } else if rt_str_eq(cmd, "sort") {
            if n != 3 {
                fail_msg("usage: csvdata sort <file> <col>");
            } else {
                let (col, cok) = str_parse_int(rt_str_concat(rt_vec_get(pos, 2), ""));
                if cok == false {
                    fail_msg("column index must be an integer");
                } else if col < 0 {
                    fail_msg("column index must not be negative");
                } else {
                    let (fields, cols, rows, status) = load_rows(rt_str_concat(rt_vec_get(pos, 1), ""));
                    if status == 2 { code = 2; } else {
                        if status == 4 {
                            fail_msg("ragged row: field count differs from the header");
                            code = 4;
                        } else {
                            if col >= cols {
                                fail_file("column out of range for: ", rt_str_concat(rt_vec_get(pos, 1), ""));
                                code = 4;
                            } else {
                                if rows <= 1 { code = 3; } else {
                                    code = cmd_sort(fields, cols, rows, col);
                                }
                            }
                        }
                    }
                    rt_vec_free(fields);
                }
            }
        } else if rt_str_eq(cmd, "agg") {
            if n != 4 {
                fail_msg("usage: csvdata agg <file> <group-col> <value-col>");
            } else {
                let (gcol, gok) = str_parse_int(rt_str_concat(rt_vec_get(pos, 2), ""));
                let (vcol, vok) = str_parse_int(rt_str_concat(rt_vec_get(pos, 3), ""));
                if gok == false {
                    fail_msg("column index must be an integer");
                } else if vok == false {
                    fail_msg("column index must be an integer");
                } else if gcol < 0 {
                    fail_msg("column index must not be negative");
                } else if vcol < 0 {
                    fail_msg("column index must not be negative");
                } else {
                    let (fields, cols, rows, status) = load_rows(rt_str_concat(rt_vec_get(pos, 1), ""));
                    if status == 2 { code = 2; } else {
                        if status == 4 {
                            fail_msg("ragged row: field count differs from the header");
                            code = 4;
                        } else {
                            if gcol >= cols {
                                fail_file("column out of range for: ", rt_str_concat(rt_vec_get(pos, 1), ""));
                                code = 4;
                            } else if vcol >= cols {
                                fail_file("column out of range for: ", rt_str_concat(rt_vec_get(pos, 1), ""));
                                code = 4;
                            } else {
                                if rows <= 1 { code = 3; } else {
                                    code = cmd_agg(fields, cols, rows, gcol, vcol);
                                }
                            }
                        }
                    }
                    rt_vec_free(fields);
                }
            }
        } else if rt_str_eq(cmd, "write") {
            if n != 3 {
                fail_msg("usage: csvdata write <file> <out>");
            } else {
                let (fields, cols, rows, status) = load_rows(rt_str_concat(rt_vec_get(pos, 1), ""));
                if status == 2 { code = 2; } else {
                    if status == 4 {
                        fail_msg("ragged row: field count differs from the header");
                        code = 4;
                    } else {
                        if rows == 0 { code = 3; } else {
                            code = cmd_write(fields, cols, rows, pos, 2);
                        }
                    }
                }
                rt_vec_free(fields);
            }
        } else {
            fail_msg("usage: csvdata <select|sort|agg|write> <file> [args]");
        }
    }

    rt_vec_free(pos);
    return code;
}
