// jsonq: pick a value out of a JSON file from the command line, like a small jq.
//
//   mink build testapps/jsonq/main.mink
//   jsonq <file.json> [path] [-r]
//
// The path is built from .key and [index], for example  .items[1].name  . With no path the whole
// document is printed. -r prints a string without its quotes.
mod json;

// Follows `path` from `root` and takes (frees) the path string. Returns the offset of the value, or -1 when the path does not match.
fn walk(arena: Ptr<Int>, root: Int, path: Str) -> Int {
    let n = rt_str_len(path);
    let mut node = root;
    let mut i = 0;
    while i < n && node >= 0 {
        let c = rt_str_byte(path, i);
        if c == 46 {
            i = i + 1;
            let start = i;
            while i < n && rt_str_byte(path, i) != 46 && rt_str_byte(path, i) != 91 {
                i = i + 1;
            }
            let klen = i - start;
            if klen > 0 {
                if json_tag(arena, node) != 5 {
                    node = -1;
                } else {
                    let count = json_obj_len(arena, node);
                    let mut found = -1;
                    let mut k = 0;
                    while k < count && found < 0 {
                        let key = json_obj_get_key(arena, node, k);
                        let mut same = rt_str_len(key) == klen;
                        let mut j = 0;
                        while same && j < klen {
                            if rt_str_byte(key, j) != rt_str_byte(path, start + j) {
                                same = false;
                            }
                            j = j + 1;
                        }
                        if same {
                            found = json_obj_get_val(arena, node, k);
                        }
                        rt_str_free(key);
                        k = k + 1;
                    }
                    node = found;
                }
            }
        } else if c == 91 {
            i = i + 1;
            let mut index = 0;
            let mut digits = 0;
            while i < n && rt_str_byte(path, i) >= 48 && rt_str_byte(path, i) <= 57 {
                index = index * 10 + (rt_str_byte(path, i) - 48);
                digits = digits + 1;
                i = i + 1;
            }
            if i < n && rt_str_byte(path, i) == 93 && digits > 0 {
                i = i + 1;
                if json_tag(arena, node) != 4 {
                    node = -1;
                } else if index >= json_arr_len(arena, node) {
                    node = -1;
                } else {
                    node = json_arr_get(arena, node, index);
                }
            } else {
                node = -1;
            }
        } else {
            node = -1;
        }
    }
    rt_str_free(path);
    return node;
}

fn main() -> Int {
    let argc = rt_argc();
    let mut file = "";
    let mut path = ".";
    let mut raw = false;
    let mut seen = 0;
    let mut a = 0;
    while a < argc {
        let arg = rt_argv(a);
        if rt_str_eq(arg, "-r") {
            raw = true;
            rt_str_free(arg);
        } else if seen == 0 {
            file = arg;
            seen = 1;
        } else {
            path = arg;
            seen = seen + 1;
        }
        a = a + 1;
    }
    if seen == 0 {
        rt_print_str("usage: jsonq <file.json> [path] [-r]");
        return 2;
    }
    if !rt_fs_exists(file) {
        rt_print_str("jsonq: no such file");
        rt_str_free(file);
        rt_str_free(path);
        return 1;
    }
    let size = rt_fs_file_size(file);
    if size > 2000000 {
        rt_print_str("jsonq: file is larger than 2 MB");
        rt_str_free(file);
        rt_str_free(path);
        return 1;
    }
    let text = rt_fs_read(file);
    let slots = size * 4 + 64;
    let arena = rt_alloc(slots * 8);
    let root = json_parse_in(text, arena, slots);
    if root == 0 {
        rt_print_str("jsonq: not valid JSON");
        rt_free(arena);
        rt_str_free(file);
        rt_str_free(path);
        return 1;
    }
    let node = walk(arena, root, rt_str_concat(path, ""));
    let mut code = 0;
    if node < 0 {
        rt_print_str("jsonq: no match");
        code = 1;
    } else if raw && json_tag(arena, node) == 3 {
        let s = json_as_str(arena, node);
        rt_print_str(s);
        rt_str_free(s);
    } else {
        let out = json_to_str(arena, node);
        rt_print_str(out);
        rt_str_free(out);
    }
    rt_free(arena);
    rt_str_free(file);
    rt_str_free(path);
    return code;
}
