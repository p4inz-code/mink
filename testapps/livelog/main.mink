// livelog: show a log file in a web page, live, as lines are added to it.
//
//   mink build testapps/livelog/main.mink
//   livelog <logfile> [port] [max-requests]
//
// Open http://127.0.0.1:8083/ in a browser. The page connects to /events, a server-sent-events stream,
// and every new line written to the file appears at once. New visitors first get the last 20 lines.
// With max-requests the server stops once it has answered that many requests and no stream is open, which is
// how the tests run it.
mod network;
mod http;
mod httpserver;
mod strings;

fn page() -> Str {
    return "<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Live log</title><style>body{background:#000;color:#f4f4f2;font:15px/1.5 Consolas,monospace;margin:0}header{position:sticky;top:0;background:#000;border-bottom:1px solid #222;padding:12px 16px;font:600 16px system-ui,sans-serif;display:flex;gap:10px;align-items:center}i{width:10px;height:10px;border-radius:50%;background:#555;display:inline-block}i.on{background:#f4f4f2}pre{margin:0;padding:12px 16px;white-space:pre-wrap;word-break:break-all}</style><header><i id=d></i><span id=s>connecting</span></header><pre id=o></pre><script>const o=document.getElementById('o'),d=document.getElementById('d'),s=document.getElementById('s');const e=new EventSource('/events');e.onopen=()=>{d.className='on';s.textContent='live'};e.onerror=()=>{d.className='';s.textContent='reconnecting'};e.onmessage=m=>{const stick=innerHeight+scrollY>=document.body.scrollHeight-40;o.append(m.data+'\\n');if(stick)scrollTo(0,document.body.scrollHeight)}</script>";
}

fn reply(client: Int, status: Int, reason: Str, kind: Str, body: Str) {
    let response = http_server_response(status, reason, kind, body);
    http_server_send(client, response);
    net_close(client);
}

// One server-sent event carrying a line of text. Takes (frees) the line.
fn event_for(line: Str) -> Str {
    let head = rt_str_concat("data: ", line);
    let out = rt_str_concat(head, "\n\n");
    rt_str_free(head);
    rt_str_free(line);
    return out;
}

// Sends `text` to every open stream and returns the ones that are still open.
fn broadcast(clients: Vec<Int>, text: Str) -> Vec<Int> {
    let mut alive = rt_vec_new(4);
    let n = rt_vec_len(clients);
    let mut i = 0;
    while i < n {
        let c = rt_vec_get(clients, i);
        let sent = http_server_send(c, rt_str_concat(text, ""));
        if sent < 0 {
            net_close(c);
        } else {
            alive = rt_vec_push(alive, c);
        }
        i = i + 1;
    }
    rt_vec_free(clients);
    rt_str_free(text);
    return alive;
}

fn main() -> Int {
    let argc = rt_argc();
    if argc < 1 {
        rt_print_str("usage: livelog <logfile> [port] [max-requests]");
        return 2;
    }
    let logfile = rt_argv(0);
    let mut port = 8083;
    let mut max = 0;
    if argc >= 2 {
        let p = rt_argv(1);
        let parsed = str_parse_int(p);
        if parsed.1 {
            port = parsed.0;
        }
    }
    if argc >= 3 {
        let m = rt_argv(2);
        let parsed = str_parse_int(m);
        if parsed.1 {
            max = parsed.0;
        }
    }
    net_init();
    let sock = http_server_listen("127.0.0.1", port);
    if sock < 0 {
        rt_print_str("livelog: cannot listen on that port");
        rt_str_free(logfile);
        net_cleanup();
        return 1;
    }
    rt_print_str("livelog on http://127.0.0.1:");
    rt_print_int(port);
    let mut clients = rt_vec_new(4);
    let mut offset = 0;
    if rt_fs_exists(logfile) {
        offset = rt_fs_file_size(logfile);
    }
    let mut served = 0;
    let mut running = true;
    while running {
        let got = http_server_serve(sock, 250, 65536);
        if got.0 != -1 {
            served = served + 1;
            let client = got.0;
            let path = http_server_path(rt_str_concat(got.1, ""));
            rt_str_free(got.1);
            if rt_str_eq(path, "/") {
                reply(client, 200, "OK", "text/html; charset=utf-8", page());
            } else if rt_str_eq(path, "/events") {
                http_server_send(client, rt_str_concat("HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: keep-alive\r\n\r\nretry: 1000\n\n", ""));
                // The last 20 lines of the file, so a new visitor sees some history.
                if rt_fs_exists(logfile) {
                    let text = rt_fs_read(logfile);
                    let lines = str_split(text, "\n");
                    let total = rt_vec_len(lines);
                    let mut from = 0;
                    if total > 21 {
                        from = total - 21;
                    }
                    let mut k = from;
                    while k < total {
                        let mut line = rt_str_concat(rt_vec_get(lines, k), "");
                        let ll = rt_str_len(line);
                        if ll > 0 && rt_str_byte(line, ll - 1) == 13 {
                            line = str_sub(line, 0, ll - 1);
                        }
                        if rt_str_len(line) > 0 {
                            http_server_send(client, event_for(line));
                        } else {
                            rt_str_free(line);
                        }
                        k = k + 1;
                    }
                    rt_vec_free(lines);
                }
                clients = rt_vec_push(clients, client);
            } else {
                reply(client, 404, "Not Found", "text/plain", "not found");
            }
            rt_str_free(path);
        }
        // Look for new lines in the file.
        if rt_fs_exists(logfile) {
            let size = rt_fs_file_size(logfile);
            if size < offset {
                offset = 0;
            }
            if size > offset {
                let text = rt_fs_read(logfile);
                let fresh = str_sub(text, offset, size);
                offset = size;
                let lines = str_split(fresh, "\n");
                let total = rt_vec_len(lines);
                let mut k = 0;
                while k < total {
                    let mut line = rt_str_concat(rt_vec_get(lines, k), "");
                    let ll = rt_str_len(line);
                    if ll > 0 && rt_str_byte(line, ll - 1) == 13 {
                        line = str_sub(line, 0, ll - 1);
                    }
                    if rt_str_len(line) > 0 {
                        clients = broadcast(clients, event_for(line));
                    } else {
                        rt_str_free(line);
                    }
                    k = k + 1;
                }
                rt_vec_free(lines);
            }
        }
        // A keep-alive comment lets the server notice streams that were closed.
        clients = broadcast(clients, rt_str_concat(": ping\n\n", ""));
        if max > 0 && served >= max && rt_vec_len(clients) == 0 {
            running = false;
        }
    }
    rt_vec_free(clients);
    http_server_close(sock);
    net_cleanup();
    rt_str_free(logfile);
    return 0;
}
