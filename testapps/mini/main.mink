// mini: a small calculator language with variables, written in MINK.
//
//   mink build testapps/mini/main.mink
//   mini < script.txt          or      mini script.txt
//
// Each line is either an expression or a binding:
//     let x = 3 + 4 * 2
//     (x - 1) % 4
// Whole-number maths: + - * / % , parentheses, unary minus, and names. Anything else on a line gives
// an error message with the position, and the next line carries on. "vars" lists the names.
//
// The parser works over an arena of integers instead of strings, because string arguments are moved by
// every call, while a pointer argument is not (the standard JSON library does the same).
//
// Arena layout (words):
//   0 position   1 length   2 error code   3 error position   4 number of variables
//   16 .. 16+256       the line, one byte per word
//   512 .. 512+64*18   variables: [name length][15 name bytes][value]
mod strings;

fn get(a: Ptr<Int>, i: Int) -> Int {
    return rt_mem_load(a + i * 8);
}

fn put(a: Ptr<Int>, i: Int, v: Int) {
    rt_mem_store(a + i * 8, v);
}

fn fail(a: Ptr<Int>, code: Int) {
    if get(a, 2) == 0 {
        put(a, 2, code);
        put(a, 3, get(a, 0));
    }
}

fn at(a: Ptr<Int>) -> Int {
    if get(a, 0) >= get(a, 1) {
        return 0;
    }
    return get(a, 16 + get(a, 0));
}

fn skip(a: Ptr<Int>) {
    while get(a, 0) < get(a, 1) && (get(a, 16 + get(a, 0)) == 32 || get(a, 16 + get(a, 0)) == 9) {
        put(a, 0, get(a, 0) + 1);
    }
}

fn is_digit(c: Int) -> Bool {
    return c >= 48 && c <= 57;
}

fn is_letter(c: Int) -> Bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}

// The slot of the variable named by the bytes at [start, end) of the line, or -1.
fn find_var(a: Ptr<Int>, start: Int, end: Int) -> Int {
    let n = get(a, 4);
    let len = end - start;
    let mut v = 0;
    while v < n {
        let base = 512 + v * 18;
        if get(a, base) == len {
            let mut same = true;
            let mut k = 0;
            while same && k < len {
                if get(a, base + 1 + k) != get(a, 16 + start + k) {
                    same = false;
                }
                k = k + 1;
            }
            if same {
                return v;
            }
        }
        v = v + 1;
    }
    return -1;
}

// Reads a name starting at the current position. Returns (start, end), and moves past it.
fn read_name(a: Ptr<Int>) -> (Int, Int) {
    let start = get(a, 0);
    while get(a, 0) < get(a, 1) && (is_letter(get(a, 16 + get(a, 0))) || is_digit(get(a, 16 + get(a, 0)))) {
        put(a, 0, get(a, 0) + 1);
    }
    return (start, get(a, 0));
}

fn parse_primary(a: Ptr<Int>) -> Int {
    skip(a);
    let c = at(a);
    if c == 40 {
        put(a, 0, get(a, 0) + 1);
        let v = parse_expr(a);
        skip(a);
        if at(a) == 41 {
            put(a, 0, get(a, 0) + 1);
        } else {
            fail(a, 3);
        }
        return v;
    }
    if is_digit(c) {
        let mut n = 0;
        while is_digit(at(a)) {
            n = n * 10 + (at(a) - 48);
            put(a, 0, get(a, 0) + 1);
        }
        return n;
    }
    if is_letter(c) {
        let name = read_name(a);
        let slot = find_var(a, name.0, name.1);
        if slot < 0 {
            fail(a, 4);
            put(a, 3, name.0);
            return 0;
        }
        return get(a, 512 + slot * 18 + 17);
    }
    if get(a, 0) >= get(a, 1) {
        fail(a, 1);
    } else {
        fail(a, 2);
    }
    return 0;
}

fn parse_unary(a: Ptr<Int>) -> Int {
    skip(a);
    if at(a) == 45 {
        put(a, 0, get(a, 0) + 1);
        return 0 - parse_unary(a);
    }
    return parse_primary(a);
}

fn parse_term(a: Ptr<Int>) -> Int {
    let mut v = parse_unary(a);
    skip(a);
    while get(a, 2) == 0 && (at(a) == 42 || at(a) == 47 || at(a) == 37) {
        let op = at(a);
        put(a, 0, get(a, 0) + 1);
        let r = parse_unary(a);
        if op == 42 {
            v = v * r;
        } else if r == 0 {
            fail(a, 5);
        } else if op == 47 {
            v = v / r;
        } else {
            v = v % r;
        }
        skip(a);
    }
    return v;
}

fn parse_expr(a: Ptr<Int>) -> Int {
    let mut v = parse_term(a);
    skip(a);
    while get(a, 2) == 0 && (at(a) == 43 || at(a) == 45) {
        let op = at(a);
        put(a, 0, get(a, 0) + 1);
        let r = parse_term(a);
        if op == 43 {
            v = v + r;
        } else {
            v = v - r;
        }
        skip(a);
    }
    return v;
}

fn message(code: Int) -> Str {
    if code == 1 {
        return "the line ends too soon";
    }
    if code == 2 {
        return "unexpected character";
    }
    if code == 3 {
        return "missing )";
    }
    if code == 4 {
        return "unknown name";
    }
    if code == 5 {
        return "division by zero";
    }
    if code == 6 {
        return "unexpected text after the expression";
    }
    if code == 7 {
        return "too many variables (the limit is 64)";
    }
    if code == 8 {
        return "a name is up to 15 letters";
    }
    return "error";
}

fn report_error(a: Ptr<Int>, line_no: Int) {
    let num = rt_str_from_int(line_no);
    let pos = rt_str_from_int(get(a, 3) + 1);
    let one = rt_str_concat("line ", num);
    let two = rt_str_concat(one, ", column ");
    let three = rt_str_concat(two, pos);
    let four = rt_str_concat(three, ": ");
    let msg = message(get(a, 2));
    let all = rt_str_concat(four, msg);
    rt_print_str(all);
    rt_str_free(num);
    rt_str_free(pos);
    rt_str_free(one);
    rt_str_free(two);
    rt_str_free(three);
    rt_str_free(four);
    rt_str_free(all);
}

// Runs the line whose `n` bytes are already in the arena. Prints the result or the error.
fn run_line(a: Ptr<Int>, n: Int, line_no: Int) {
    if n > 256 {
        put(a, 2, 2);
        put(a, 3, 256);
        report_error(a, line_no);
        return;
    }
    put(a, 0, 0);
    put(a, 1, n);
    put(a, 2, 0);
    put(a, 3, 0);
    skip(a);
    if get(a, 0) >= get(a, 1) {
        return;
    }
    // "vars" lists the names.
    let first = get(a, 0);
    let word = read_name(a);
    let wlen = word.1 - word.0;
    let is_vars = wlen == 4 && get(a, 16 + word.0) == 118 && get(a, 17 + word.0) == 97 && get(a, 18 + word.0) == 114 && get(a, 19 + word.0) == 115;
    let is_let = wlen == 3 && get(a, 16 + word.0) == 108 && get(a, 17 + word.0) == 101 && get(a, 18 + word.0) == 116;
    if is_vars {
        let count = get(a, 4);
        let mut v = 0;
        while v < count {
            let base = 512 + v * 18;
            let len = get(a, base);
            let name = rt_str_alloc(len);
            let mut k = 0;
            while k < len {
                rt_str_set_byte(name, k, get(a, base + 1 + k));
                k = k + 1;
            }
            let num = rt_str_from_int(get(a, base + 17));
            let left = rt_str_concat(name, " = ");
            let out = rt_str_concat(left, num);
            rt_print_str(out);
            rt_str_free(name);
            rt_str_free(num);
            rt_str_free(left);
            rt_str_free(out);
            v = v + 1;
        }
        return;
    }
    if is_let {
        skip(a);
        let target = read_name(a);
        let tlen = target.1 - target.0;
        skip(a);
        if tlen == 0 || tlen > 15 {
            if tlen > 15 {
                fail(a, 8);
            } else {
                fail(a, 2);
            }
            report_error(a, line_no);
            return;
        }
        if at(a) != 61 {
            fail(a, 2);
            report_error(a, line_no);
            return;
        }
        put(a, 0, get(a, 0) + 1);
        let v = parse_expr(a);
        skip(a);
        if get(a, 2) == 0 && get(a, 0) < get(a, 1) {
            fail(a, 6);
        }
        if get(a, 2) != 0 {
            report_error(a, line_no);
            return;
        }
        let mut slot = find_var(a, target.0, target.1);
        if slot < 0 {
            if get(a, 4) >= 64 {
                fail(a, 7);
                report_error(a, line_no);
                return;
            }
            slot = get(a, 4);
            put(a, 4, slot + 1);
            let base = 512 + slot * 18;
            put(a, base, tlen);
            let mut k = 0;
            while k < tlen {
                put(a, base + 1 + k, get(a, 16 + target.0 + k));
                k = k + 1;
            }
        }
        put(a, 512 + slot * 18 + 17, v);
        let name = rt_str_alloc(tlen);
        let mut k = 0;
        while k < tlen {
            rt_str_set_byte(name, k, get(a, 16 + target.0 + k));
            k = k + 1;
        }
        let num = rt_str_from_int(v);
        let left = rt_str_concat(name, " = ");
        let out = rt_str_concat(left, num);
        rt_print_str(out);
        rt_str_free(name);
        rt_str_free(num);
        rt_str_free(left);
        rt_str_free(out);
        return;
    }
    // A plain expression: start again from the first character.
    put(a, 0, first);
    let v = parse_expr(a);
    skip(a);
    if get(a, 2) == 0 && get(a, 0) < get(a, 1) {
        fail(a, 6);
    }
    if get(a, 2) != 0 {
        report_error(a, line_no);
        return;
    }
    rt_print_int(v);
}

fn main() -> Int {
    let mut text = "";
    if rt_argc() >= 1 {
        let path = rt_argv(0);
        if !rt_fs_exists(path) {
            rt_print_str("mini: no such file");
            rt_str_free(path);
            return 2;
        }
        text = rt_fs_read(path);
        rt_str_free(path);
    } else {
        text = rt_stdin_read();
    }
    let a = rt_alloc(2048 * 8);
    let mut z = 0;
    while z < 2048 {
        put(a, z, 0);
        z = z + 1;
    }
    let lines = str_split(text, "\n");
    let count = rt_vec_len(lines);
    let mut i = 0;
    while i < count {
        let mut line = rt_str_concat(rt_vec_get(lines, i), "");
        let ll = rt_str_len(line);
        if ll > 0 && rt_str_byte(line, ll - 1) == 13 {
            line = str_sub(line, 0, ll - 1);
        }
        let n = rt_str_len(line);
        if n <= 256 {
            let mut k = 0;
            while k < n {
                put(a, 16 + k, rt_str_byte(line, k));
                k = k + 1;
            }
        }
        run_line(a, n, i + 1);
        rt_str_free(line);
        i = i + 1;
    }
    rt_vec_free(lines);
    rt_free(a);
    return 0;
}
