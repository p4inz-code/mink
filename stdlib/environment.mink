// MINK Environment Library
// Session 65 - Environment variable access
// Session 182 - Repaired the module so `mod environment;` loads.
//
// Provides functions to get, set, check, and remove environment variables,
// plus the current working directory. The runtime predeclares the `rt_env_*`
// and `rt_fs_get_cwd` intrinsics; this module exposes them under the
// unprefixed names used by the rest of the standard library.
//
// API:
//   env_get(name: Str) -> Str          Owned value; empty when unset.
//   env_set(name: Str, value: Str) -> Int   0 on success, -1 on failure.
//   env_has(name: Str) -> Bool         Whether the variable exists.
//   env_remove(name: Str) -> Int       0 on success, -1 on failure.
//   env_cwd() -> Str                   Owned current working directory.
//
// Ownership:
//   - env_get and env_cwd return a newly allocated Str (caller owns it).
//   - Str arguments are consumed by the call, as for every MINK function.
//   - Int/Bool results are immediates.
//
// Security considerations:
//   - Environment variables are inherited by child processes
//   - Sensitive values should not be stored in environment variables
//   - env_set modifies the current process environment only
//
// Windows-specific behavior:
//   - Variable names are case-insensitive on Windows
//   - Empty string values are supported
//   - Maximum variable value length is platform-dependent (~32KB on Windows)
//
// Portability note: the intrinsics have Windows and frozen Linux
// implementations; this module contains only portable wrappers.

// The `rt_env_*` intrinsics copy their `Str` arguments into C strings and
// release those copies, but they do not release the MINK `Str` arguments
// themselves. Because a `Str` parameter is consumed by the call, each wrapper
// below frees it explicitly — the same contract the filesystem and strings
// modules follow. Without this the leak checker reports E-R06 at exit for any
// call given a heap string.

// Get the value of an environment variable.
// Returns an owned empty string if the variable does not exist.
fn env_get(name: Str) -> Str {
    let result = rt_env_get(name);
    rt_str_free(name);
    return result;
}

// Set an environment variable for this process.
// Returns 0 on success, -1 on failure.
fn env_set(name: Str, value: Str) -> Int {
    let result = rt_env_set(name, value);
    rt_str_free(name);
    rt_str_free(value);
    return result;
}

// Check whether an environment variable exists.
fn env_has(name: Str) -> Bool {
    let result = rt_env_has(name);
    rt_str_free(name);
    return result;
}

// Remove an environment variable.
// Returns 0 on success, -1 on failure.
fn env_remove(name: Str) -> Int {
    let result = rt_env_remove(name);
    rt_str_free(name);
    return result;
}

// Get the current working directory as an owned string.
fn env_cwd() -> Str {
    return rt_fs_get_cwd();
}
