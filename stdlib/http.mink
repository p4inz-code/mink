// ==========================================================================
// MINK HTTP Library V1 — Sessions 69-70
//
// HTTP/1.1 client library over TCP sockets.
//
// Declares its TCP dependency explicitly: `mod network;` (resolved as a
// sibling module, or from the bundled standard library) provides
// `net_tcp_socket`, `net_close`, `net_recv` and `net_last_error`.  A user
// only needs `mod http;` — the transitive dependency is discovered by the
// module loader instead of failing with a missing `net_*` name.
mod network;
//
// IMPORTANT: MINK strings must be explicitly freed with rt_str_free.
//   User functions with Str parameters CONSUME (move) the argument.
//   Runtime intrinsics (rt_str_byte, rt_str_len, rt_str_set_byte) do NOT consume.
//   All string-building uses rt_str_alloc + rt_str_set_byte.
//
// Scope:
//   - HTTP/1.1 request construction and serialization
//   - HTTP/1.1 response parsing
//   - Content-Length body handling
//   - Transfer-Encoding: chunked body decoding in http_body (Session 147)
//   - Case-insensitive header lookup
//   - Connection: close semantics (no keep-alive)
//
// Limits:
//   - Max body size: 4,194,304 bytes (4 MB, Session 125)
//   - Max headers: 64
//   - Chunked framing is decoded by http_body; chunk extensions and trailer
//     fields are ignored, and other transfer codings are not decoded
//   - A non-chunked response that delivers fewer body bytes than its declared
//     Content-Length is reported as HTTP_ERR_RECV instead of a completed
//     request (Session 137)
//   - No HTTPS (TLS is a separate library)
//
// Failure model (Session 125): an HTTP response always contains a status
// line, so an empty string returned by http_client_get/http_client_post
// never means "successful empty response" — it means the request failed
// (DNS, connect, send, an empty/aborted transfer, or an oversized body). The
// reason is available from
// http_last_error(): 0 after a completed request, a Winsock error code
// after a network failure, or one of the local HTTP_ERR_* codes.
// ==========================================================================

// --- Constants ---

// The nominal maximum response body. The receive budget is MAX_BODY() + 8 KiB
// for the whole response, headers included (see http_recv_all).
fn MAX_BODY() -> Int { return 4194304; }

// Local http_last_error() codes (negative; Winsock codes are positive).
fn HTTP_ERR_SOCKET() -> Int { return -1; }
fn HTTP_ERR_CONNECT() -> Int { return -2; }
fn HTTP_ERR_SEND() -> Int { return -3; }
fn HTTP_ERR_TOO_LARGE() -> Int { return -4; }
// The transfer did not complete: either no response bytes arrived (the peer
// closed or aborted the connection before sending a status line), or a
// non-chunked response delivered fewer body bytes than the Content-Length it
// declared (Session 137). An HTTP response always has a status line, so this
// is a failed request, not a successful empty response.
fn HTTP_ERR_RECV() -> Int { return -5; }

// The error code of the most recent HTTP request on the calling thread
// (0 = it completed). Session 144: this is per-thread runtime state, not a
// module global — a request on another thread can never overwrite the reason
// this thread observes. Runtime intrinsics are the storage, so no module
// binding and no initialization are required: rt_init allocates the slot
// before main and every thread starts at 0.
fn http_last_error() -> Int {
    return rt_thread_local_get();
}

// True when `response` is a completed HTTP response (non-empty; every
// real response starts with a status line).
fn http_response_ok(response: Str) -> Bool {
    let ok = rt_str_len(response) > 0;
    rt_str_free(response);
    return ok;
}

// --- Utility Functions ---

// Parse digits from a byte range (non-allocating).
fn http_parse_int_from_bytes(s: Str, start: Int, end: Int) -> Int {
    let mut result = 0;
    let mut i = start;
    while i < end {
        let b = rt_str_byte(s, i);
        let digit = b - 48;
        if digit >= 0 {
            if digit <= 9 {
                result = result * 10 + digit;
            }
        }
        i = i + 1;
    }
    rt_str_free(s);
    return result;
}

// Parse a string to integer.
fn rt_str_parse_int(s: Str) -> Int {
    let len = rt_str_len(s);
    let mut result = 0;
    let mut negative = false;
    let mut i = 0;
    if len > 0 {
        if rt_str_byte(s, 0) == 45 {
            negative = true;
            i = 1;
        }
    }
    while i < len {
        let b = rt_str_byte(s, i);
        let digit = b - 48;
        if digit >= 0 {
            if digit <= 9 {
                result = result * 10 + digit;
            }
        }
        i = i + 1;
    }
    if negative == true {
        result = 0 - result;
    }
    rt_str_free(s);
    return result;
}

// Build a substring by reading bytes into a new allocation.
fn http_sub_bytes(s: Str, start: Int, end: Int) -> Str {
    let len = rt_str_len(s);
    let mut actual_end = end;
    if actual_end > len {
        actual_end = len;
    }
    let size = actual_end - start;
    let mut result = "";
    if size > 0 {
        result = rt_str_alloc(size);
        let mut i = 0;
        while i < size {
            rt_str_set_byte(result, i, rt_str_byte(s, start + i));
            i = i + 1;
        }
    }
    rt_str_free(s);
    return result;
}

// Convert a single byte to a one-character string.
fn rt_str_from_char(b: Int) -> Str {
    let result = rt_str_alloc(1);
    rt_str_set_byte(result, 0, b);
    return result;
}

// Check if byte is in [A-Z] range.
fn http_is_upper(b: Int) -> Bool {
    if b >= 65 {
        if b <= 90 {
            return true;
        }
    }
    return false;
}

// Convert byte to lowercase.
fn http_to_lower(b: Int) -> Int {
    if http_is_upper(b) == true {
        return b + 32;
    }
    return b;
}

// Compare two bytes case-insensitively.
fn http_byte_eq_ci(a: Int, b: Int) -> Bool {
    if http_to_lower(a) == http_to_lower(b) {
        return true;
    }
    return false;
}

// --- URL Parsing ---

// Extract the host from a URL string. Caller must rt_str_free the result.
fn http_url_host(url: Str) -> Str {
    let len = rt_str_len(url);
    let mut skip = 0;
    if len >= 7 {
        if rt_str_byte(url, 0) == 104 {
            if rt_str_byte(url, 1) == 116 {
                if rt_str_byte(url, 2) == 116 {
                    if rt_str_byte(url, 3) == 112 {
                        if rt_str_byte(url, 4) == 58 {
                            if rt_str_byte(url, 5) == 47 {
                                if rt_str_byte(url, 6) == 47 {
                                    skip = 7;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let mut host_end = len;
    let mut i = skip;
    while i < len {
        let b = rt_str_byte(url, i);
        if b == 58 {
            host_end = i;
            break;
        }
        if b == 47 {
            host_end = i;
            break;
        }
        i = i + 1;
    }
    return http_sub_bytes(url, skip, host_end);
}

// Extract the port from a URL string. Returns Int directly (no string alloc).
fn http_url_port(url: Str) -> Int {
    let len = rt_str_len(url);
    let mut skip = 0;
    if len >= 7 {
        if rt_str_byte(url, 0) == 104 {
            if rt_str_byte(url, 1) == 116 {
                if rt_str_byte(url, 2) == 116 {
                    if rt_str_byte(url, 3) == 112 {
                        if rt_str_byte(url, 4) == 58 {
                            if rt_str_byte(url, 5) == 47 {
                                if rt_str_byte(url, 6) == 47 {
                                    skip = 7;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // Parse inline instead of forwarding to `http_parse_int_from_bytes`: a
    // user call would consume `url`, and the port may simply be absent, so
    // the release below must be the one unconditional move.
    let mut port = 80;
    let mut found = 0;
    let mut i = skip;
    while i < len && found == 0 {
        let b = rt_str_byte(url, i);
        if b == 58 {
            let port_start = i + 1;
            let mut port_end = len;
            let mut j = port_start;
            while j < len {
                if rt_str_byte(url, j) == 47 {
                    port_end = j;
                    break;
                }
                j = j + 1;
            }
            port = 0;
            let mut pi = port_start;
            while pi < port_end {
                let digit = rt_str_byte(url, pi) - 48;
                if digit >= 0 {
                    if digit <= 9 {
                        port = port * 10 + digit;
                    }
                }
                pi = pi + 1;
            }
            found = 1;
        }
        i = i + 1;
    }
    rt_str_free(url);
    return port;
}

// Extract the path from a URL string. Caller must rt_str_free the result.
fn http_url_path(url: Str) -> Str {
    let len = rt_str_len(url);
    let mut skip = 0;
    if len >= 7 {
        if rt_str_byte(url, 0) == 104 {
            if rt_str_byte(url, 1) == 116 {
                if rt_str_byte(url, 2) == 116 {
                    if rt_str_byte(url, 3) == 112 {
                        if rt_str_byte(url, 4) == 58 {
                            if rt_str_byte(url, 5) == 47 {
                                if rt_str_byte(url, 6) == 47 {
                                    skip = 7;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let mut path_start = len;
    let mut i = skip;
    while i < len {
        if rt_str_byte(url, i) == 47 {
            path_start = i;
            break;
        }
        i = i + 1;
    }
    // Always forward `url` to the consuming helper (one unconditional move),
    // then substitute the default path when the URL has none.
    let sub = http_sub_bytes(url, path_start, len);
    let mut result = sub;
    if rt_str_len(result) == 0 {
        result = "/";
    }
    return result;
}

// --- Request Creation ---

// Create an HTTP request line. Caller must rt_str_free the result.
fn http_request(method: Str, path: Str) -> Str {
    let m_len = rt_str_len(method);
    let p_len = rt_str_len(path);
    let suffix = " HTTP/1.1\r\n";
    let s_len = rt_str_len(suffix);
    let total = m_len + 1 + p_len + s_len;
    let result = rt_str_alloc(total);
    // Copy method
    let mut i = 0;
    while i < m_len {
        rt_str_set_byte(result, i, rt_str_byte(method, i));
        i = i + 1;
    }
    rt_str_set_byte(result, m_len, 32);
    // Copy path
    i = 0;
    while i < p_len {
        rt_str_set_byte(result, m_len + 1 + i, rt_str_byte(path, i));
        i = i + 1;
    }
    // Copy suffix
    i = 0;
    while i < s_len {
        rt_str_set_byte(result, m_len + 1 + p_len + i, rt_str_byte(suffix, i));
        i = i + 1;
    }
    rt_str_free(method);
    rt_str_free(path);
    return result;
}

// Create an HTTP GET request line.
fn http_get(path: Str) -> Str {
    return http_request("GET", path);
}

// --- Header Management ---

// Add a header to an HTTP request string. Caller must rt_str_free the result.
fn http_add_header(request: Str, name: Str, value: Str) -> Str {
    let r_len = rt_str_len(request);
    let n_len = rt_str_len(name);
    let v_len = rt_str_len(value);
    let colon = ": ";
    let crlf = "\r\n";
    let c_len = rt_str_len(colon);
    let cr_len = rt_str_len(crlf);
    let total = r_len + n_len + c_len + v_len + cr_len;
    let result = rt_str_alloc(total);
    let mut pos = 0;
    let mut i = 0;
    while i < r_len {
        rt_str_set_byte(result, pos + i, rt_str_byte(request, i));
        i = i + 1;
    }
    pos = pos + r_len;
    i = 0;
    while i < n_len {
        rt_str_set_byte(result, pos + i, rt_str_byte(name, i));
        i = i + 1;
    }
    pos = pos + n_len;
    i = 0;
    while i < c_len {
        rt_str_set_byte(result, pos + i, rt_str_byte(colon, i));
        i = i + 1;
    }
    pos = pos + c_len;
    i = 0;
    while i < v_len {
        rt_str_set_byte(result, pos + i, rt_str_byte(value, i));
        i = i + 1;
    }
    pos = pos + v_len;
    i = 0;
    while i < cr_len {
        rt_str_set_byte(result, pos + i, rt_str_byte(crlf, i));
        i = i + 1;
    }
    rt_str_free(request);
    rt_str_free(name);
    rt_str_free(value);
    return result;
}

// Finalize a request by adding the empty line after headers.
fn http_finalize_request(request: Str) -> Str {
    let r_len = rt_str_len(request);
    let crlf = "\r\n";
    let c_len = rt_str_len(crlf);
    let total = r_len + c_len;
    let result = rt_str_alloc(total);
    let mut i = 0;
    while i < r_len {
        rt_str_set_byte(result, i, rt_str_byte(request, i));
        i = i + 1;
    }
    i = 0;
    while i < c_len {
        rt_str_set_byte(result, r_len + i, rt_str_byte(crlf, i));
        i = i + 1;
    }
    rt_str_free(request);
    return result;
}

// --- Header Extraction ---

// Find a header value by name (case-insensitive). Returns "" if not found.
fn http_header(response: Str, name: Str) -> Str {
    let len = rt_str_len(response);
    let name_len = rt_str_len(name);
    // Single-exit structure: V1 ownership is not path-sensitive, so the
    // consumed inputs are released exactly once below instead of at each
    // early return.
    let mut result = "";
    let mut done = 0;
    let mut i = 0;
    while i < len - 1 && done == 0 {
        let b1 = rt_str_byte(response, i);
        let b2 = rt_str_byte(response, i + 1);
        if b1 == 13 && b2 == 10 {
            i = i + 2;
            let mut header_count = 0;
            while i < len - 1 && done == 0 {
                let h1 = rt_str_byte(response, i);
                let h2 = rt_str_byte(response, i + 1);
                if h1 == 13 && h2 == 10 {
                    done = 1;
                } else if header_count >= 64 {
                    done = 1;
                } else {
                    let mut colon_pos = i;
                    while colon_pos < len {
                        if rt_str_byte(response, colon_pos) == 58 {
                            break;
                        }
                        colon_pos = colon_pos + 1;
                    }
                    let mut name_match = true;
                    let mut j = 0;
                    while j < name_len {
                        if j >= colon_pos - i {
                            name_match = false;
                            break;
                        }
                        let hb = rt_str_byte(response, i + j);
                        let nb = rt_str_byte(name, j);
                        if http_byte_eq_ci(hb, nb) == false {
                            name_match = false;
                            break;
                        }
                        j = j + 1;
                    }
                    if name_match == true && j == name_len {
                        let mut vs = colon_pos + 1;
                        if vs < len {
                            if rt_str_byte(response, vs) == 32 {
                                vs = vs + 1;
                            }
                        }
                        let mut ve = vs;
                        while ve < len - 1 {
                            if rt_str_byte(response, ve) == 13 {
                                break;
                            }
                            ve = ve + 1;
                        }
                        let vsize = ve - vs;
                        if vsize > 0 {
                            result = rt_str_alloc(vsize);
                            let mut vi = 0;
                            while vi < vsize {
                                rt_str_set_byte(result, vi, rt_str_byte(response, vs + vi));
                                vi = vi + 1;
                            }
                        }
                        done = 1;
                    } else {
                        while i < len - 1 {
                            let hb1 = rt_str_byte(response, i);
                            let hb2 = rt_str_byte(response, i + 1);
                            if hb1 == 13 && hb2 == 10 {
                                i = i + 2;
                                break;
                            }
                            i = i + 1;
                        }
                        header_count = header_count + 1;
                    }
                }
            }
            done = 1;
        } else {
            i = i + 1;
        }
    }
    rt_str_free(response);
    rt_str_free(name);
    return result;
}

// Get Content-Length from response. Returns -1 if not found.
fn http_content_length(response: Str) -> Int {
    let len = rt_str_len(response);
    // Single-exit structure (see http_header): one unconditional release.
    let mut result = -1;
    let mut done = 0;
    let mut i = 0;
    while i < len - 1 && done == 0 {
        let b1 = rt_str_byte(response, i);
        let b2 = rt_str_byte(response, i + 1);
        if b1 == 13 && b2 == 10 {
            i = i + 2;
            let mut header_count = 0;
            while i < len - 1 && done == 0 {
                let h1 = rt_str_byte(response, i);
                let h2 = rt_str_byte(response, i + 1);
                if h1 == 13 && h2 == 10 {
                    done = 1;
                } else if header_count >= 64 {
                    done = 1;
                } else {
                    let mut is_cl = true;
                    let cl_upper = "Content-Length";
                    let cl_lower = "content-length";
                    let cl_len = 14;
                    if i + cl_len < len {
                        let mut k = 0;
                        while k < cl_len {
                            let hb = rt_str_byte(response, i + k);
                            let ub = rt_str_byte(cl_upper, k);
                            let lb = rt_str_byte(cl_lower, k);
                            if hb != ub {
                                if hb != lb {
                                    is_cl = false;
                                    break;
                                }
                            }
                            k = k + 1;
                        }
                    } else {
                        is_cl = false;
                    }
                    if is_cl == true {
                        let mut colon_pos = i;
                        while colon_pos < len {
                            if rt_str_byte(response, colon_pos) == 58 {
                                break;
                            }
                            colon_pos = colon_pos + 1;
                        }
                        let mut vs = colon_pos + 1;
                        if vs < len {
                            if rt_str_byte(response, vs) == 32 {
                                vs = vs + 1;
                            }
                        }
                        let mut ve = vs;
                        while ve < len {
                            if rt_str_byte(response, ve) == 13 {
                                break;
                            }
                            ve = ve + 1;
                        }
                        // Parse Content-Length value inline (non-consuming)
                        let mut cl_val = 0;
                        let mut ci = vs;
                        while ci < ve {
                            let cb = rt_str_byte(response, ci);
                            cl_val = cl_val * 10 + (cb - 48);
                            ci = ci + 1;
                        }
                        result = cl_val;
                        done = 1;
                    } else {
                        while i < len - 1 {
                            let hb1 = rt_str_byte(response, i);
                            let hb2 = rt_str_byte(response, i + 1);
                            if hb1 == 13 && hb2 == 10 {
                                i = i + 2;
                                break;
                            }
                            i = i + 1;
                        }
                        header_count = header_count + 1;
                    }
                }
            }
            done = 1;
        } else {
            i = i + 1;
        }
    }
    rt_str_free(response);
    return result;
}

// --- Response Parsing ---

// Parse status code from HTTP response (directly from bytes, no alloc).
fn http_status_code(response: Str) -> Int {
    let len = rt_str_len(response);
    let mut code = 0;
    if len >= 12 {
        let mut ci = 9;
        while ci < len {
            let b = rt_str_byte(response, ci);
            if b == 32 {
                break;
            }
            code = code * 10 + (b - 48);
            ci = ci + 1;
        }
    }
    rt_str_free(response);
    return code;
}

// Parse reason phrase from HTTP response. Caller must rt_str_free the result.
fn http_status_text(response: Str) -> Str {
    let len = rt_str_len(response);
    let mut result = "";
    if len >= 12 {
        let mut status_end = 9;
        while status_end < len {
            if rt_str_byte(response, status_end) == 32 {
                break;
            }
            status_end = status_end + 1;
        }
        let reason_start = status_end + 1;
        if reason_start < len {
            let mut reason_end = reason_start;
            while reason_end < len - 1 {
                if rt_str_byte(response, reason_end) == 13 {
                    break;
                }
                reason_end = reason_end + 1;
            }
            let size = reason_end - reason_start;
            if size > 0 {
                result = rt_str_alloc(size);
                let mut ti = 0;
                while ti < size {
                    rt_str_set_byte(result, ti, rt_str_byte(response, reason_start + ti));
                    ti = ti + 1;
                }
            }
        }
    }
    rt_str_free(response);
    return result;
}

// --- Chunked transfer decoding (Session 147) ---

// Hexadecimal value of one byte, or -1 when it is not a hex digit. Case does
// not matter: both "1a" and "1A" are 26.
fn _http_hex_digit(b: Int) -> Int {
    if b >= 48 {
        if b <= 57 { return b - 48; }
    }
    if b >= 97 {
        if b <= 102 { return b - 87; }
    }
    if b >= 65 {
        if b <= 70 { return b - 55; }
    }
    return -1;
}

// True when `b` can appear inside an HTTP token. The transfer-coding search
// uses it so "chunked" must be a whole token, never part of a longer word.
fn _http_token_byte(b: Int) -> Bool {
    if b >= 48 {
        if b <= 57 { return true; }
    }
    if b >= 65 {
        if b <= 90 { return true; }
    }
    if b >= 97 {
        if b <= 122 { return true; }
    }
    if b == 45 { return true; }
    return false;
}

// Classify response body framing: 1 when a Transfer-Encoding header carries
// the "chunked" coding, 0 otherwise (Content-Length, close-delimited, or a
// coding this client does not decode). Header names and values are compared
// case-insensitively. Non-consuming: `response` is returned in .1 so the
// caller keeps its single unconditional release.
fn _http_encoding(response: Str, len: Int) -> (Int, Str) {
    let mut kind = 0;
    // Skip the status line.
    let mut i = 0;
    let mut first = 0;
    while i + 1 < len && first == 0 {
        if rt_str_byte(response, i) == 13 && rt_str_byte(response, i + 1) == 10 {
            i = i + 2;
            first = 1;
        } else {
            i = i + 1;
        }
    }
    let mut lines = 0;
    let mut going = first;
    while going == 1 && lines < 64 && kind == 0 {
        if i + 1 >= len {
            going = 0;
        } else {
            if rt_str_byte(response, i) == 13 && rt_str_byte(response, i + 1) == 10 {
                going = 0;
            } else {
                let ls = i;
                let mut le = i;
                let mut le_done = 0;
                while le + 1 < len && le_done == 0 {
                    if rt_str_byte(response, le) == 13 && rt_str_byte(response, le + 1) == 10 {
                        le_done = 1;
                    } else {
                        le = le + 1;
                    }
                }
                // "Transfer-Encoding" followed by ':'.
                let mut is_te = 1;
                let mut k = 0;
                while k < 17 && is_te == 1 {
                    if ls + k >= le {
                        is_te = 0;
                    } else {
                        if http_to_lower(rt_str_byte(response, ls + k)) != http_to_lower(rt_str_byte("Transfer-Encoding", k)) {
                            is_te = 0;
                        }
                    }
                    k = k + 1;
                }
                if is_te == 1 {
                    if ls + 17 >= le {
                        is_te = 0;
                    } else {
                        if rt_str_byte(response, ls + 17) != 58 {
                            is_te = 0;
                        }
                    }
                }
                if is_te == 1 {
                    // Search the value for the whole token "chunked".
                    let vs = ls + 18;
                    let mut t = vs;
                    while t + 7 <= le && kind == 0 {
                        let mut hit = 1;
                        let mut m = 0;
                        while m < 7 {
                            if http_to_lower(rt_str_byte(response, t + m)) != http_to_lower(rt_str_byte("chunked", m)) {
                                hit = 0;
                            }
                            m = m + 1;
                        }
                        if hit == 1 {
                            let mut bounds = 1;
                            if t > vs {
                                if _http_token_byte(rt_str_byte(response, t - 1)) == true {
                                    bounds = 0;
                                }
                            }
                            if t + 7 < le {
                                if _http_token_byte(rt_str_byte(response, t + 7)) == true {
                                    bounds = 0;
                                }
                            }
                            if bounds == 1 {
                                kind = 1;
                            }
                        }
                        t = t + 1;
                    }
                }
                lines = lines + 1;
                i = le + 2;
            }
        }
    }
    return (kind, response);
}

// Decode a chunked body in response[start..end]. The receive helper has
// already accumulated the whole response, so framing may cross any number of
// TCP receives; this walk never assumes a packet boundary. Returns
// (decoded, response); `response` is not freed, so `http_body` keeps its
// single release. Malformed framing yields an empty body and HTTP_ERR_RECV
// unless a more specific error is already present; a chunk that would push
// the decoded body past MAX_BODY yields HTTP_ERR_TOO_LARGE. Both are bounded
// by the wire bytes actually received: an attacker-controlled size is never
// used as an allocation size.
fn _http_chunked_decode(response: Str, start: Int, end: Int) -> (Str, Str) {
    let wire = end - start;
    let mut cap = wire;
    if cap < 1 {
        cap = 1;
    }
    let temp = rt_str_alloc(cap);
    let mut pos = start;
    let mut out = 0;
    let mut ok = 1;
    let mut too_large = 0;
    let mut done = 0;
    while done == 0 && ok == 1 {
        // Chunk-size line: at least one hex digit, optional ";extensions"
        // ignored through CRLF.
        let mut value = 0;
        let mut digits = 0;
        let mut line_done = 0;
        while pos < end && line_done == 0 {
            let b = rt_str_byte(response, pos);
            let hv = _http_hex_digit(b);
            if hv >= 0 {
                digits = digits + 1;
                if value <= MAX_BODY() {
                    value = value * 16 + hv;
                }
                pos = pos + 1;
            } else {
                if b == 59 {
                    while pos < end && rt_str_byte(response, pos) != 13 {
                        pos = pos + 1;
                    }
                    line_done = 1;
                } else {
                    if b == 13 {
                        line_done = 1;
                    } else {
                        ok = 0;
                        line_done = 1;
                    }
                }
            }
        }
        let mut crlf_ok = 0;
        if ok == 1 {
            if pos + 1 < end {
                if rt_str_byte(response, pos) == 13 && rt_str_byte(response, pos + 1) == 10 {
                    crlf_ok = 1;
                }
            }
        }
        if ok == 1 && crlf_ok == 1 {
            pos = pos + 2;
        } else {
            ok = 0;
        }
        if ok == 1 && digits == 0 {
            ok = 0;
        }
        if ok == 1 && value > MAX_BODY() {
            too_large = 1;
            ok = 0;
        }
        if ok == 1 {
            if value == 0 {
                // Last chunk: consume trailer fields up to the blank line.
                // Trailer bytes are never appended to the body.
                let mut trailers = 0;
                while trailers == 0 && ok == 1 {
                    if pos + 1 >= end {
                        ok = 0;
                    } else {
                        if rt_str_byte(response, pos) == 13 && rt_str_byte(response, pos + 1) == 10 {
                            pos = pos + 2;
                            trailers = 1;
                        } else {
                            let mut le = pos;
                            let mut term = 0 - 1;
                            while le + 1 < end && term < 0 {
                                if rt_str_byte(response, le) == 13 && rt_str_byte(response, le + 1) == 10 {
                                    term = le;
                                } else {
                                    le = le + 1;
                                }
                            }
                            if term < 0 {
                                ok = 0;
                            } else {
                                pos = term + 2;
                            }
                        }
                    }
                }
                done = 1;
            } else {
                if out + value > MAX_BODY() {
                    too_large = 1;
                    ok = 0;
                }
            }
        }
        if ok == 1 && value > 0 {
            if pos + value > end {
                ok = 0;
            }
        }
        if ok == 1 && value > 0 {
            let mut k = 0;
            while k < value {
                rt_str_set_byte(temp, out + k, rt_str_byte(response, pos + k));
                k = k + 1;
            }
            out = out + value;
            pos = pos + value;
            // The CRLF that closes the chunk data.
            if pos + 1 < end {
                if rt_str_byte(response, pos) == 13 && rt_str_byte(response, pos + 1) == 10 {
                    pos = pos + 2;
                } else {
                    ok = 0;
                }
            } else {
                ok = 0;
            }
        }
    }
    let mut result = "";
    if ok == 1 {
        if out > 0 {
            result = rt_str_alloc(out);
            let mut ri = 0;
            while ri < out {
                rt_str_set_byte(result, ri, rt_str_byte(temp, ri));
                ri = ri + 1;
            }
        }
    } else {
        if too_large == 1 {
            rt_thread_local_set(HTTP_ERR_TOO_LARGE());
        } else {
            if rt_thread_local_get() == 0 {
                rt_thread_local_set(HTTP_ERR_RECV());
            }
        }
    }
    rt_str_free(temp);
    return (result, response);
}

// --- Body Extraction ---

// Extract body from HTTP response (after first \r\n\r\n). A
// Transfer-Encoding: chunked body is decoded; every other response keeps the
// previous behavior (raw bytes after the header block).
fn http_body(response: Str) -> Str {
    let len = rt_str_len(response);
    let mut resp = response;
    let mut result = "";
    let mut found = 0;
    let mut body_start = 0;
    let mut i = 0;
    while i < len - 3 && found == 0 {
        let b1 = rt_str_byte(resp, i);
        let b2 = rt_str_byte(resp, i + 1);
        let b3 = rt_str_byte(resp, i + 2);
        let b4 = rt_str_byte(resp, i + 3);
        if b1 == 13 {
            if b2 == 10 {
                if b3 == 13 {
                    if b4 == 10 {
                        body_start = i + 4;
                        found = 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    if found == 1 {
        let enc = _http_encoding(resp, len);
        resp = enc.1;
        if enc.0 == 1 {
            let dec = _http_chunked_decode(resp, body_start, len);
            result = dec.0;
            resp = dec.1;
        } else {
            let size = len - body_start;
            if size > 0 {
                result = rt_str_alloc(size);
                let mut bi = 0;
                while bi < size {
                    rt_str_set_byte(result, bi, rt_str_byte(resp, body_start + bi));
                    bi = bi + 1;
                }
            }
        }
    }
    rt_str_free(resp);
    return result;
}

// --- Client ---

// Receive all data from a socket until connection close. The receive budget
// is MAX_BODY() + 8 KiB of response bytes, headers included: the headroom
// exists so a full MAX_BODY body plus its headers fits. On return the
// calling thread's http_last_error() is 0 when the transfer completed within that
// budget, or HTTP_ERR_TOO_LARGE when the peer was still sending at the
// budget (the received prefix is truncated at the budget, never silently
// extended).
fn http_recv_all(sock: Int) -> Str {
    // Start with a small staging buffer and grow it by doubling as the body
    // arrives. The runtime arena can be a fixed 4 MiB bump heap (Linux), so
    // reserving `max_size` (MAX_BODY() + 8 KiB) upfront exhausts it before a
    // single byte is read; most responses fit in the small buffer and never
    // touch the rest.
    let max_size = MAX_BODY() + 8192;
    let mut cap = 8192;
    if cap > max_size {
        cap = max_size;
    }
    let mut buf = rt_str_alloc(cap);
    let mut total = 0;
    // open tracks whether the peer is still sending. V1 move semantics
    // forbid freeing `data` in an early-exit branch and then using it
    // again textually, so each chunk is freed exactly once, at the
    // bottom of the loop body.
    let mut open = 1;
    // Termination is guaranteed without a chunk-count cap: every open chunk
    // adds at least one byte, so `total` reaches `max_size`, and EOF turns
    // `open` off. The old `chunk_count < 1024` cap stopped a complete 4 MiB
    // response early (1024 reads of at most 4096 bytes also have to carry the
    // headers), truncating it ~4 KiB short and reporting TOO_LARGE.
    while total < max_size && open == 1 {
        let data = net_recv(sock, 4096);
        let data_len = rt_str_len(data);
        if data_len == 0 {
            open = 0;
        }
        let mut ci = 0;
        if open == 1 {
            if total + data_len > cap && cap < max_size {
                // Double, clamped to max_size. total <= cap and data_len is
                // at most one net_recv chunk, so the doubled capacity always
                // holds this chunk (the copy below still clips at max_size).
                let mut newcap = cap * 2;
                if newcap > max_size {
                    newcap = max_size;
                }
                let grown = rt_str_alloc(newcap);
                while ci < total {
                    rt_str_set_byte(grown, ci, rt_str_byte(buf, ci));
                    ci = ci + 1;
                }
                rt_str_free(buf);
                buf = grown;
                cap = newcap;
                ci = 0;
            }
            while ci < data_len {
                if total + ci < max_size {
                    rt_str_set_byte(buf, total + ci, rt_str_byte(data, ci));
                }
                ci = ci + 1;
            }
        }
        rt_str_free(data);
        if open == 1 {
            total = total + data_len;
        }
    }
    if open == 1 {
        // The buffer filled while the peer was still sending. One extra
        // byte distinguishes an exactly-limit response from an overflow:
        // a closed peer returns 0, more data sets HTTP_ERR_TOO_LARGE so
        // the truncation is never silent.
        let extra = net_recv(sock, 1);
        let extra_len = rt_str_len(extra);
        rt_str_free(extra);
        if extra_len > 0 {
            rt_thread_local_set(HTTP_ERR_TOO_LARGE());
        }
    }
    // The last chunk can push `total` past the budget. Writes above
    // `max_size` were clipped and the buffer's capacity is `max_size`, so
    // clamp the copied length: otherwise the copy reads past the buffer and
    // an oversized response fails with E-R09 instead of the documented
    // TOO_LARGE result.
    if total > max_size {
        total = max_size;
    }
    // Copy the received bytes into an exact-length result so that
    // rt_str_len(result) equals the number of bytes actually received
    // (the accumulation buffer is capacity-sized, not data-sized).
    let result = rt_str_alloc(total);
    let mut ri = 0;
    while ri < total {
        rt_str_set_byte(result, ri, rt_str_byte(buf, ri));
        ri = ri + 1;
    }
    rt_str_free(buf);
    return result;
}

// --- Response completion facts (Session 137) ---

// The completion verdict for a raw response: `result.0` is 1 when the transfer
// is incomplete, i.e. a non-chunked response delivered fewer body bytes than
// the Content-Length it declared. `response` is consumed and handed back in
// `result.1` (the module's V1 ownership style: a helper that must read a `Str`
// and still leave it live for the caller returns it). `is_head` is 1 when the
// request method was HEAD. Read with non-consuming intrinsics only.
//
// The check is skipped, and the verdict stays 0, when
//   - a Transfer-Encoding header is present: the body framing is not
//     Content-Length-delimited, which covers every chunked response;
//   - no Content-Length header is present or its value is not digits: the
//     existing protocol behavior accepts such a response;
//   - the status cannot carry a body (any 1xx, 204 No Content, 304 Not
//     Modified) or the request method is HEAD: their Content-Length describes
//     a body that is deliberately not sent;
//   - the header block never ended: the declared length is then not
//     comparable, so the receive path's own result stands.
fn _http_incomplete(response: Str, is_head: Int) -> (Int, Str) {
    let len = rt_str_len(response);
    let mut bodyless = 0;
    // Status line: bytes 9.. to the first space.
    if len >= 12 {
        let mut code = 0;
        let mut ci = 9;
        let mut code_ok = 1;
        while ci < len {
            let b = rt_str_byte(response, ci);
            if b == 32 {
                ci = len;
            } else {
                if b < 48 || b > 57 {
                    code_ok = 0;
                    ci = len;
                } else {
                    code = code * 10 + (b - 48);
                    ci = ci + 1;
                }
            }
        }
        if code_ok == 1 {
            if code >= 100 && code < 200 {
                bodyless = 1;
            }
            if code == 204 {
                bodyless = 1;
            }
            if code == 304 {
                bodyless = 1;
            }
        }
    }
    if is_head == 1 {
        bodyless = 1;
    }
    // Header block: declared Content-Length or -1, Transfer-Encoding present,
    // received body length or -1 when the blank line never arrived.
    let mut cl = 0 - 1;
    let mut te = 0;
    let mut body = 0 - 1;
    let mut i = 0;
    let mut seen = 0;
    while i < len - 1 && seen == 0 {
        if rt_str_byte(response, i) == 13 && rt_str_byte(response, i + 1) == 10 {
            i = i + 2;
            seen = 1;
        } else {
            i = i + 1;
        }
    }
    let mut lines = 0;
    let mut going = seen;
    while going == 1 && lines < 64 {
        if i + 1 >= len {
            going = 0;
        } else {
            let h1 = rt_str_byte(response, i);
            let h2 = rt_str_byte(response, i + 1);
            if h1 == 13 && h2 == 10 {
                body = len - (i + 2);
                going = 0;
            } else {
                let ls = i;
                let mut le = i;
                let mut le_done = 0;
                while le + 1 < len && le_done == 0 {
                    if rt_str_byte(response, le) == 13 && rt_str_byte(response, le + 1) == 10 {
                        le_done = 1;
                    } else {
                        le = le + 1;
                    }
                }
                // "Content-Length:" (case-insensitive, exact name then colon).
                let mut is_cl = 0;
                if ls + 14 < len {
                    is_cl = 1;
                    let mut k = 0;
                    while k < 14 {
                        let mut a = rt_str_byte(response, ls + k);
                        let mut b = rt_str_byte("Content-Length", k);
                        if a >= 97 && a <= 122 {
                            a = a - 32;
                        }
                        if b >= 97 && b <= 122 {
                            b = b - 32;
                        }
                        if a != b {
                            is_cl = 0;
                        }
                        k = k + 1;
                    }
                    if rt_str_byte(response, ls + 14) != 58 {
                        is_cl = 0;
                    }
                }
                if is_cl == 1 {
                    let mut vs = ls + 15;
                    if vs < len && rt_str_byte(response, vs) == 32 {
                        vs = vs + 1;
                    }
                    let mut v = 0;
                    let mut vd = vs;
                    let mut good = 1;
                    while vd < le {
                        let c = rt_str_byte(response, vd);
                        if c < 48 || c > 57 {
                            good = 0;
                            vd = le;
                        } else {
                            v = v * 10 + (c - 48);
                            vd = vd + 1;
                        }
                    }
                    // A malformed or empty value counts as absent, so a header
                    // the client cannot interpret never fails a response that
                    // the previous implementation accepted.
                    if good == 1 && vs < le {
                        cl = v;
                    }
                }
                // "Transfer-Encoding:" (any value: framing is not
                // Content-Length-delimited, which covers chunked).
                let mut is_te = 0;
                if ls + 17 < len {
                    is_te = 1;
                    let mut k = 0;
                    while k < 17 {
                        let mut a = rt_str_byte(response, ls + k);
                        let mut b = rt_str_byte("Transfer-Encoding", k);
                        if a >= 97 && a <= 122 {
                            a = a - 32;
                        }
                        if b >= 97 && b <= 122 {
                            b = b - 32;
                        }
                        if a != b {
                            is_te = 0;
                        }
                        k = k + 1;
                    }
                    if rt_str_byte(response, ls + 17) != 58 {
                        is_te = 0;
                    }
                }
                if is_te == 1 {
                    te = 1;
                }
                lines = lines + 1;
                i = le + 2;
            }
        }
    }
    let mut verdict = 0;
    if bodyless == 0 && te == 0 && cl >= 0 && body >= 0 && body < cl {
        verdict = 1;
    }
    return (verdict, response);
}

// Send an HTTP request and return the complete response.
// Consumes `request` and `host` (freed on every path). The raw rt_net_*
// intrinsics below borrow their string arguments, so both parameters stay
// live here and are freed exactly once, at the single textual exit.
//
// On any failure the result is "" and http_last_error() reports the
// reason: a socket-creation failure (HTTP_ERR_SOCKET), a DNS/connect
// failure (HTTP_ERR_CONNECT; net_last_error() still holds the Winsock
// code), or a send failure (HTTP_ERR_SEND). A response that outgrew
// MAX_BODY is HTTP_ERR_TOO_LARGE (the received prefix is still returned).
fn http_send(request: Str, host: Str, port: Int) -> Str {
    rt_thread_local_set(0);
    // Initialize Winsock on first use so `http_client_get`/`http_client_post`
    // work in a fresh program: the stdlib client is a complete entry point
    // and callers are not required to call `net_init` themselves. WSAStartup
    // is idempotent, and the session is released by the process exit (or by
    // the caller's `net_cleanup`).
    let mut sock = -1;
    if net_init() == 0 {
        sock = net_tcp_socket();
    }
    let mut can_send = 0;
    if sock != -1 {
        can_send = 1;
    }
    let mut sent_ok = 0;
    if can_send == 1 {
        let conn = rt_net_connect(sock, host, port);
        if conn == 0 {
            sent_ok = 1;
        } else {
            rt_thread_local_set(HTTP_ERR_CONNECT());
        }
    } else {
        rt_thread_local_set(HTTP_ERR_SOCKET());
    }
    if sent_ok == 1 {
        let sent = rt_net_send(sock, request);
        if sent == -1 {
            sent_ok = 0;
            rt_thread_local_set(HTTP_ERR_SEND());
        }
    }
    let mut response = "";
    if sent_ok == 1 {
        response = http_recv_all(sock);
        // A peer that closes or resets before sending anything leaves the
        // receive helper with zero bytes and no local error. That is still a
        // failed request: without this, such a transfer would report
        // http_last_error() == 0, which the failure model reserves for a
        // completed response.
        if rt_str_len(response) == 0 {
            rt_thread_local_set(HTTP_ERR_RECV());
        }
    }
    // Session 137: a non-chunked response that declares more body bytes than it
    // delivered is an incomplete transfer, not a completed request. Checked
    // only when nothing more specific already failed (an oversized response is
    // TOO_LARGE, a refused connection is CONNECT, an empty response is RECV
    // above), and never for a Transfer-Encoding response, whose framing is not
    // Content-Length-delimited. Responses that cannot carry a body at all
    // (1xx, 204, 304, or a reply to HEAD) are exempt: their Content-Length
    // describes the body the client did not ask for.
    if rt_thread_local_get() == 0 && rt_str_len(response) > 0 {
        // "HEAD" in the method position, case-insensitively.
        let mut is_head = 0;
        if rt_str_len(request) >= 4 {
            is_head = 1;
            let mut k = 0;
            while k < 4 {
                let mut a = rt_str_byte(request, k);
                if a >= 97 && a <= 122 {
                    a = a - 32;
                }
                if a != rt_str_byte("HEAD", k) {
                    is_head = 0;
                }
                k = k + 1;
            }
        }
        let check = _http_incomplete(response, is_head);
        response = check.1;
        if check.0 == 1 {
            rt_thread_local_set(HTTP_ERR_RECV());
        }
    }
    if sock != -1 {
        net_close(sock);
    }
    rt_str_free(request);
    rt_str_free(host);
    return response;
}

// --- Low-Level Client ---

// Build a GET request with Host and Connection headers, send it.
fn http_client_get_with(host: Str, port: Int, path: Str) -> Str {
    // Build full request using only intrinsics (non-consuming)
    let p_len = rt_str_len(path);
    let h_len = rt_str_len(host);
    // "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"
    let head = "GET ";
    let mid = " HTTP/1.1\r\nHost: ";
    let tail = "\r\nConnection: close\r\n\r\n";
    let sp = rt_str_len(head);
    let sm = rt_str_len(mid);
    let st = rt_str_len(tail);
    let total = sp + p_len + sm + h_len + st;
    let result = rt_str_alloc(total);
    // "GET "
    rt_str_set_byte(result, 0, 71); // G
    rt_str_set_byte(result, 1, 69); // E
    rt_str_set_byte(result, 2, 84); // T
    rt_str_set_byte(result, 3, 32); // space
    // path
    let mut i = 0;
    while i < p_len {
        rt_str_set_byte(result, sp + i, rt_str_byte(path, i));
        i = i + 1;
    }
    // " HTTP/1.1\r\nHost: "
    i = 0;
    while i < sm {
        rt_str_set_byte(result, sp + p_len + i, rt_str_byte(mid, i));
        i = i + 1;
    }
    // host
    i = 0;
    while i < h_len {
        rt_str_set_byte(result, sp + p_len + sm + i, rt_str_byte(host, i));
        i = i + 1;
    }
    // "\r\nConnection: close\r\n\r\n"
    i = 0;
    while i < st {
        rt_str_set_byte(result, sp + p_len + sm + h_len + i, rt_str_byte(tail, i));
        i = i + 1;
    }
    let response = http_send(result, host, port);
    rt_str_free(path);
    return response;
}

// Build a POST request with body, send it.
fn http_client_post_with(host: Str, port: Int, path: Str, body: Str) -> Str {
    let p_len = rt_str_len(path);
    let h_len = rt_str_len(host);
    let b_len = rt_str_len(body);
    let prefix = "POST ";
    let suffix1 = " HTTP/1.1\r\nHost: ";
    let suffix2 = "\r\nContent-Type: text/plain\r\nConnection: close\r\nContent-Length: ";
    let suffix3 = "\r\n\r\n";
    let sp1 = rt_str_len(prefix);
    let ss1 = rt_str_len(suffix1);
    let ss2 = rt_str_len(suffix2);
    let ss3 = rt_str_len(suffix3);
    let mut cl_digits = 1;
    let mut cl_temp = b_len;
    if cl_temp >= 10 { cl_digits = 2; }
    if cl_temp >= 100 { cl_digits = 3; }
    if cl_temp >= 1000 { cl_digits = 4; }
    if cl_temp >= 10000 { cl_digits = 5; }
    if cl_temp >= 100000 { cl_digits = 6; }
    if cl_temp >= 1000000 { cl_digits = 7; }
    let total = sp1 + p_len + ss1 + h_len + ss2 + cl_digits + ss3 + b_len;
    let result = rt_str_alloc(total);
    let mut pos = 0;
    // Copy prefix
    let mut i = 0;
    while i < sp1 {
        rt_str_set_byte(result, pos + i, rt_str_byte(prefix, i));
        i = i + 1;
    }
    pos = pos + sp1;
    // Copy path
    i = 0;
    while i < p_len {
        rt_str_set_byte(result, pos + i, rt_str_byte(path, i));
        i = i + 1;
    }
    pos = pos + p_len;
    // Copy suffix1
    i = 0;
    while i < ss1 {
        rt_str_set_byte(result, pos + i, rt_str_byte(suffix1, i));
        i = i + 1;
    }
    pos = pos + ss1;
    // Copy host
    i = 0;
    while i < h_len {
        rt_str_set_byte(result, pos + i, rt_str_byte(host, i));
        i = i + 1;
    }
    pos = pos + h_len;
    // Copy suffix2
    i = 0;
    while i < ss2 {
        rt_str_set_byte(result, pos + i, rt_str_byte(suffix2, i));
        i = i + 1;
    }
    pos = pos + ss2;
    // Write Content-Length digits inline
    let mut cd = 1;
    if cl_digits >= 2 { cd = 10; }
    if cl_digits >= 3 { cd = 100; }
    if cl_digits >= 4 { cd = 1000; }
    if cl_digits >= 5 { cd = 10000; }
    if cl_digits >= 6 { cd = 100000; }
    if cl_digits >= 7 { cd = 1000000; }
    let mut di = 0;
    while di < cl_digits {
        let digit_val = (b_len / cd) - ((b_len / cd) / 10) * 10;
        rt_str_set_byte(result, pos + di, 48 + digit_val);
        cd = cd / 10;
        di = di + 1;
    }
    pos = pos + cl_digits;
    // Copy suffix3
    i = 0;
    while i < ss3 {
        rt_str_set_byte(result, pos + i, rt_str_byte(suffix3, i));
        i = i + 1;
    }
    pos = pos + ss3;
    // Copy body
    i = 0;
    while i < b_len {
        rt_str_set_byte(result, pos + i, rt_str_byte(body, i));
        i = i + 1;
    }
    let response = http_send(result, host, port);
    rt_str_free(path);
    rt_str_free(body);
    return response;
}

// --- High-Level Client ---
// All URL parsing uses rt_str_byte (non-consuming intrinsic).
// No user function is called on `url` except http_sub_bytes at the end.

// Perform an HTTP GET request from a URL string.
fn http_client_get(url: Str) -> Str {
    let len = rt_str_len(url);
    let mut skip = 0;
    if len >= 7 {
        if rt_str_byte(url, 0) == 104 {
            if rt_str_byte(url, 1) == 116 {
                if rt_str_byte(url, 2) == 116 {
                    if rt_str_byte(url, 3) == 112 {
                        if rt_str_byte(url, 4) == 58 {
                            if rt_str_byte(url, 5) == 47 {
                                if rt_str_byte(url, 6) == 47 {
                                    skip = 7;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let mut host_end = len;
    let mut colon_pos = len;
    let mut path_start = len;
    let mut i = skip;
    while i < len {
        let b = rt_str_byte(url, i);
        if b == 58 {
            host_end = i;
            colon_pos = i;
        }
        if b == 47 {
            if path_start == len {
                path_start = i;
            }
        }
        i = i + 1;
    }
    if colon_pos == len {
        host_end = path_start;
    }
    // Build host string (non-consuming)
    let host_size = host_end - skip;
    let mut host = "";
    if host_size > 0 {
        host = rt_str_alloc(host_size);
        i = skip;
        while i < host_end {
            rt_str_set_byte(host, i - skip, rt_str_byte(url, i));
            i = i + 1;
        }
    }
    // Build path string (non-consuming)
    let mut use_path = "/";
    if path_start < len {
        let path_size = len - path_start;
        use_path = rt_str_alloc(path_size);
        i = path_start;
        while i < len {
            rt_str_set_byte(use_path, i - path_start, rt_str_byte(url, i));
            i = i + 1;
        }
    }
    // Parse port inline (non-consuming)
    let mut port = 80;
    if colon_pos < len {
        let port_start = colon_pos + 1;
        let mut port_end = len;
        i = port_start;
        while i < len {
            if rt_str_byte(url, i) == 47 {
                port_end = i;
                break;
            }
            i = i + 1;
        }
        let mut pv = 0;
        i = port_start;
        while i < port_end {
            pv = pv * 10 + (rt_str_byte(url, i) - 48);
            i = i + 1;
        }
        port = pv;
    }
    let response = http_client_get_with(host, port, use_path);
    rt_str_free(url);
    return response;
}

// Perform an HTTP POST request from a URL string with a body.
fn http_client_post(url: Str, body: Str) -> Str {
    let len = rt_str_len(url);
    let mut skip = 0;
    if len >= 7 {
        if rt_str_byte(url, 0) == 104 {
            if rt_str_byte(url, 1) == 116 {
                if rt_str_byte(url, 2) == 116 {
                    if rt_str_byte(url, 3) == 112 {
                        if rt_str_byte(url, 4) == 58 {
                            if rt_str_byte(url, 5) == 47 {
                                if rt_str_byte(url, 6) == 47 {
                                    skip = 7;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let mut host_end = len;
    let mut colon_pos = len;
    let mut path_start = len;
    let mut i = skip;
    while i < len {
        let b = rt_str_byte(url, i);
        if b == 58 {
            host_end = i;
            colon_pos = i;
        }
        if b == 47 {
            if path_start == len {
                path_start = i;
            }
        }
        i = i + 1;
    }
    if colon_pos == len {
        host_end = path_start;
    }
    let host_size = host_end - skip;
    let mut host = "";
    if host_size > 0 {
        host = rt_str_alloc(host_size);
        i = skip;
        while i < host_end {
            rt_str_set_byte(host, i - skip, rt_str_byte(url, i));
            i = i + 1;
        }
    }
    let mut use_path = "/";
    if path_start < len {
        let path_size = len - path_start;
        use_path = rt_str_alloc(path_size);
        i = path_start;
        while i < len {
            rt_str_set_byte(use_path, i - path_start, rt_str_byte(url, i));
            i = i + 1;
        }
    }
    let mut port = 80;
    if colon_pos < len {
        let port_start = colon_pos + 1;
        let mut port_end = len;
        i = port_start;
        while i < len {
            if rt_str_byte(url, i) == 47 {
                port_end = i;
                break;
            }
            i = i + 1;
        }
        let mut pv = 0;
        i = port_start;
        while i < port_end {
            pv = pv * 10 + (rt_str_byte(url, i) - 48);
            i = i + 1;
        }
        port = pv;
    }
    let response = http_client_post_with(host, port, use_path, body);
    rt_str_free(url);
    return response;
}
