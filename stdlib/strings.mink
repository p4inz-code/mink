// MINK Strings Library v1.1.0 — Session 53
// Second official MINK ecosystem library.
//
// V1 OWNERSHIP CONSTRAINT: Str parameters are consumed by user functions.
// MINK V1 does NOT have NLL — if `s` appears in any return statement,
// it is marked as moved for the ENTIRE function. Therefore:
//   - Every function must have EXACTLY ONE return statement
//   - `s` can appear in intrinsic calls (rt_str_len, rt_str_byte, etc.)
//   - `s` can appear in the FINAL return statement
//   - `s` must NOT appear in any conditional return
//
// API patterns:
//   - Search/inspection: fn f(s, ...) -> (result, Str)  [s returned at end]
//   - Transformation: fn f(s, ...) -> Str  [new string returned, s consumed]
//   - Validation: fn f(s) -> (Bool, Str)  [s returned at end]

// ============================================================================
// Comparison
// ============================================================================

fn str_cmp(a: Str, b: Str) -> Int {
    let alen = rt_str_len(a);
    let blen = rt_str_len(b);
    let mut minlen = alen;
    if blen < minlen { minlen = blen; }
    let mut result = 0;
    let mut i = 0;
    let mut done = 0;
    while i < minlen && done == 0 {
        let ca = rt_str_byte(a, i);
        let cb = rt_str_byte(b, i);
        if ca < cb { result = -1; done = 1; }
        if ca > cb { result = 1; done = 1; }
        i = i + 1;
    }
    if done == 0 && alen < blen { result = -1; }
    if done == 0 && alen > blen { result = 1; }
    return result;
}

// ============================================================================
// Search — single return with (result, s) at end
// ============================================================================

fn str_index_of(s: Str, sub: Str) -> (Int, Str) {
    let slen = rt_str_len(s);
    let sublen = rt_str_len(sub);
    let mut result = -1;
    if sublen == 0 { result = 0; }
    if sublen > slen { result = -1; }
    if sublen > 0 && sublen <= slen {
        let mut i = 0;
        let limit = slen - sublen;
        while i <= limit && result == -1 {
            let mut match_found = true;
            let mut j = 0;
            while j < sublen && match_found {
                if rt_str_byte(s, i + j) != rt_str_byte(sub, j) {
                    match_found = false;
                }
                j = j + 1;
            }
            if match_found { result = i; }
            i = i + 1;
        }
    }
    return (result, s);
}

fn str_last_index_of(s: Str, sub: Str) -> (Int, Str) {
    let slen = rt_str_len(s);
    let sublen = rt_str_len(sub);
    let mut result = -1;
    if sublen == 0 { result = slen; }
    if sublen > slen { result = -1; }
    if sublen > 0 && sublen <= slen {
        let mut i = slen - sublen;
        let mut done = 0;
        while i >= 0 && done == 0 {
            let mut match_found = true;
            let mut j = 0;
            while j < sublen && match_found {
                if rt_str_byte(s, i + j) != rt_str_byte(sub, j) {
                    match_found = false;
                }
                j = j + 1;
            }
            if match_found { result = i; done = 1; }
            if i == 0 { done = 1; }
            if done == 0 { i = i - 1; }
        }
    }
    return (result, s);
}

fn str_contains(s: Str, sub: Str) -> (Bool, Str) {
    let r = str_index_of(s, sub);
    return (r.0 >= 0, r.1);
}

fn str_starts_with(s: Str, prefix: Str) -> (Bool, Str) {
    let slen = rt_str_len(s);
    let plen = rt_str_len(prefix);
    let mut result = true;
    if plen > slen { result = false; }
    if plen <= slen {
        let mut i = 0;
        while i < plen && result {
            if rt_str_byte(s, i) != rt_str_byte(prefix, i) { result = false; }
            i = i + 1;
        }
    }
    return (result, s);
}

fn str_ends_with(s: Str, suffix: Str) -> (Bool, Str) {
    let slen = rt_str_len(s);
    let slen2 = rt_str_len(suffix);
    let mut result = true;
    if slen2 > slen { result = false; }
    if slen2 <= slen {
        let mut i = 0;
        while i < slen2 && result {
            if rt_str_byte(s, slen - slen2 + i) != rt_str_byte(suffix, i) { result = false; }
            i = i + 1;
        }
    }
    return (result, s);
}

fn str_count(s: Str, sub: Str) -> (Int, Str) {
    let sublen = rt_str_len(sub);
    let slen = rt_str_len(s);
    let mut count = 0;
    if sublen > 0 && sublen <= slen {
        let mut pos = 0;
        while pos <= slen - sublen {
            let mut match_found = true;
            let mut j = 0;
            while j < sublen {
                if rt_str_byte(s, pos + j) != rt_str_byte(sub, j) {
                    match_found = false;
                    j = sublen;
                } else {
                    j = j + 1;
                }
            }
            if match_found { count = count + 1; }
            if match_found { pos = pos + sublen; }
            if !match_found { pos = pos + 1; }
        }
    }
    return (count, s);
}

// ============================================================================
// Validation — single return
// ============================================================================

fn str_is_numeric(s: Str) -> (Bool, Str) {
    let len = rt_str_len(s);
    let mut result = true;
    if len == 0 { result = false; }
    let mut i = 0;
    while i < len && result {
        let b = rt_str_byte(s, i);
        if b < 48 || b > 57 { result = false; }
        i = i + 1;
    }
    return (result, s);
}

fn str_is_alpha(s: Str) -> (Bool, Str) {
    let len = rt_str_len(s);
    let mut result = true;
    if len == 0 { result = false; }
    let mut i = 0;
    while i < len && result {
        let b = rt_str_byte(s, i);
        if !(b >= 65 && b <= 90) && !(b >= 97 && b <= 122) { result = false; }
        i = i + 1;
    }
    return (result, s);
}

fn str_is_alphanumeric(s: Str) -> (Bool, Str) {
    let len = rt_str_len(s);
    let mut result = true;
    if len == 0 { result = false; }
    let mut i = 0;
    while i < len && result {
        let b = rt_str_byte(s, i);
        if !(b >= 48 && b <= 57) && !(b >= 65 && b <= 90) && !(b >= 97 && b <= 122) {
            result = false;
        }
        i = i + 1;
    }
    return (result, s);
}

// ============================================================================
// Substring — consumes input, produces new string
// ============================================================================

fn str_sub(s: Str, start_in: Int, end_in: Int) -> Str {
    let len = rt_str_len(s);
    let mut start = start_in;
    let mut end = end_in;
    if start < 0 { start = 0; }
    if end > len { end = len; }
    if end < start { end = start; }
    let sublen = end - start;
    let out = rt_str_alloc(sublen);
    let mut i = 0;
    while i < sublen {
        rt_str_set_byte(out, i, rt_str_byte(s, start + i));
        i = i + 1;
    }
    return out;
}

// ============================================================================
// Trimming — consumes input, produces new string
// ============================================================================

fn _is_whitespace(b: Int) -> Bool {
    if b == 32 { return true; }
    if b == 9 { return true; }
    if b == 10 { return true; }
    if b == 13 { return true; }
    if b == 11 { return true; }
    if b == 12 { return true; }
    return false;
}

fn str_trim(s: Str) -> Str {
    let len = rt_str_len(s);
    // Find first non-whitespace
    let mut start = 0;
    let mut start_done = 0;
    while start < len && start_done == 0 {
        let b = rt_str_byte(s, start);
        if b != 32 && b != 9 && b != 10 && b != 13 {
            start_done = 1;
        }
        if start_done == 0 { start = start + 1; }
    }
    if start == len {
        return rt_str_alloc(0);
    }
    // Find last non-whitespace + 1
    let mut end = len;
    let mut end_done = 0;
    while end > start && end_done == 0 {
        let b = rt_str_byte(s, end - 1);
        if b != 32 && b != 9 && b != 10 && b != 13 {
            end_done = 1;
        }
        if end_done == 0 { end = end - 1; }
    }
    return str_sub(s, start, end);
}

fn str_trim_start(s: Str) -> Str {
    let len = rt_str_len(s);
    let mut start = 0;
    let mut done = 0;
    while start < len && done == 0 {
        let b = rt_str_byte(s, start);
        if b != 32 && b != 9 && b != 10 && b != 13 {
            done = 1;
        }
        if done == 0 { start = start + 1; }
    }
    return str_sub(s, start, len);
}

fn str_trim_end(s: Str) -> Str {
    let len = rt_str_len(s);
    let mut end = len;
    let mut done = 0;
    while end > 0 && done == 0 {
        let b = rt_str_byte(s, end - 1);
        if b != 32 && b != 9 && b != 10 && b != 13 {
            done = 1;
        }
        if done == 0 { end = end - 1; }
    }
    return str_sub(s, 0, end);
}

// ============================================================================
// Case conversion (ASCII only) — consumes input, produces new string
// ============================================================================

fn str_to_upper(s: Str) -> Str {
    let len = rt_str_len(s);
    let out = rt_str_alloc(len);
    let mut i = 0;
    while i < len {
        let b = rt_str_byte(s, i);
        if b >= 97 && b <= 122 {
            rt_str_set_byte(out, i, b - 32);
        } else {
            rt_str_set_byte(out, i, b);
        }
        i = i + 1;
    }
    return out;
}

fn str_to_lower(s: Str) -> Str {
    let len = rt_str_len(s);
    let out = rt_str_alloc(len);
    let mut i = 0;
    while i < len {
        let b = rt_str_byte(s, i);
        if b >= 65 && b <= 90 {
            rt_str_set_byte(out, i, b + 32);
        } else {
            rt_str_set_byte(out, i, b);
        }
        i = i + 1;
    }
    return out;
}

// ============================================================================
// Repeat / Padding — consumes input, produces new string
// ============================================================================

fn str_repeat(s: Str, count: Int) -> Str {
    if count <= 0 { return rt_str_alloc(0); }
    let slen = rt_str_len(s);
    let total = slen * count;
    let out = rt_str_alloc(total);
    let mut i = 0;
    while i < count {
        let mut j = 0;
        while j < slen {
            rt_str_set_byte(out, i * slen + j, rt_str_byte(s, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn str_pad_left(s: Str, target_len: Int, pad_byte: Int) -> Str {
    let slen = rt_str_len(s);
    if slen >= target_len {
        let out = rt_str_alloc(slen);
        let mut i = 0;
        while i < slen {
            rt_str_set_byte(out, i, rt_str_byte(s, i));
            i = i + 1;
        }
        return out;
    }
    let pad_len = target_len - slen;
    let out = rt_str_alloc(target_len);
    let mut i = 0;
    while i < pad_len {
        rt_str_set_byte(out, i, pad_byte);
        i = i + 1;
    }
    let mut j = 0;
    while j < slen {
        rt_str_set_byte(out, pad_len + j, rt_str_byte(s, j));
        j = j + 1;
    }
    return out;
}

fn str_pad_right(s: Str, target_len: Int, pad_byte: Int) -> Str {
    let slen = rt_str_len(s);
    if slen >= target_len {
        let out = rt_str_alloc(slen);
        let mut i = 0;
        while i < slen {
            rt_str_set_byte(out, i, rt_str_byte(s, i));
            i = i + 1;
        }
        return out;
    }
    let out = rt_str_alloc(target_len);
    let mut i = 0;
    while i < slen {
        rt_str_set_byte(out, i, rt_str_byte(s, i));
        i = i + 1;
    }
    while i < target_len {
        rt_str_set_byte(out, i, pad_byte);
        i = i + 1;
    }
    return out;
}

// ============================================================================
// Reverse — consumes input, produces new string
// ============================================================================

fn str_reverse(s: Str) -> Str {
    let len = rt_str_len(s);
    let out = rt_str_alloc(len);
    let mut i = 0;
    while i < len {
        rt_str_set_byte(out, i, rt_str_byte(s, len - 1 - i));
        i = i + 1;
    }
    return out;
}

// ============================================================================
// Replace — consumes inputs, produces new string
// ============================================================================

fn str_replace(s: Str, old: Str, new: Str) -> Str {
    let slen = rt_str_len(s);
    let oldlen = rt_str_len(old);
    let newlen = rt_str_len(new);
    let r = str_index_of(s, old);
    let idx = r.0;
    let s2 = r.1;
    let mut result_len = slen;
    if idx >= 0 { result_len = slen - oldlen + newlen; }
    let out = rt_str_alloc(result_len);
    if idx < 0 {
        let mut ci = 0;
        while ci < slen {
            rt_str_set_byte(out, ci, rt_str_byte(s2, ci));
            ci = ci + 1;
        }
    }
    if idx >= 0 {
        let mut i = 0;
        while i < idx {
            rt_str_set_byte(out, i, rt_str_byte(s2, i));
            i = i + 1;
        }
        let mut j = 0;
        while j < newlen {
            rt_str_set_byte(out, idx + j, rt_str_byte(new, j));
            j = j + 1;
        }
        let mut k = idx + oldlen;
        while k < slen {
            rt_str_set_byte(out, idx + newlen + (k - idx - oldlen), rt_str_byte(s2, k));
            k = k + 1;
        }
    }
    return out;
}

fn str_replace_all(s: Str, old: Str, new: Str) -> Str {
    let oldlen = rt_str_len(old);
    let slen = rt_str_len(s);
    let newlen = rt_str_len(new);
    if oldlen == 0 {
        let out = rt_str_alloc(slen);
        let mut ci = 0;
        while ci < slen {
            rt_str_set_byte(out, ci, rt_str_byte(s, ci));
            ci = ci + 1;
        }
        return out;
    }
    // First pass: count occurrences
    let mut count = 0;
    let mut pos = 0;
    while pos <= slen - oldlen {
        let mut match_found = true;
        let mut j = 0;
        while j < oldlen {
            if rt_str_byte(s, pos + j) != rt_str_byte(old, j) {
                match_found = false;
                j = oldlen;
            } else {
                j = j + 1;
            }
        }
        if match_found { count = count + 1; }
        if match_found { pos = pos + oldlen; }
        if !match_found { pos = pos + 1; }
    }
    if count == 0 {
        let out = rt_str_alloc(slen);
        let mut ci = 0;
        while ci < slen {
            rt_str_set_byte(out, ci, rt_str_byte(s, ci));
            ci = ci + 1;
        }
        return out;
    }
    // Second pass: build result
    let result_len = slen + count * (newlen - oldlen);
    let out = rt_str_alloc(result_len);
    let mut out_pos = 0;
    let mut src_pos = 0;
    let mut replacements_done = 0;
    while replacements_done < count {
        let mut next_pos = src_pos;
        let mut found = 0;
        while next_pos <= slen - oldlen && found == 0 {
            let mut mf = true;
            let mut j2 = 0;
            while j2 < oldlen {
                if rt_str_byte(s, next_pos + j2) != rt_str_byte(old, j2) {
                    mf = false;
                    j2 = oldlen;
                } else {
                    j2 = j2 + 1;
                }
            }
            if mf { found = 1; }
            if found == 0 { next_pos = next_pos + 1; }
        }
        if found == 0 { replacements_done = count; }
        if found == 1 {
            let mut ci = src_pos;
            while ci < next_pos {
                rt_str_set_byte(out, out_pos, rt_str_byte(s, ci));
                out_pos = out_pos + 1;
                ci = ci + 1;
            }
            let mut cj = 0;
            while cj < newlen {
                rt_str_set_byte(out, out_pos, rt_str_byte(new, cj));
                out_pos = out_pos + 1;
                cj = cj + 1;
            }
            src_pos = next_pos + oldlen;
            replacements_done = replacements_done + 1;
        }
    }
    // Copy rest
    while src_pos < slen {
        rt_str_set_byte(out, out_pos, rt_str_byte(s, src_pos));
        out_pos = out_pos + 1;
        src_pos = src_pos + 1;
    }
    return out;
}

// ============================================================================
// Join
// ============================================================================

fn str_join_2(a: Str, b: Str) -> Str {
    return rt_str_concat(a, b);
}

fn str_join_3(a: Str, b: Str, c: Str) -> Str {
    let ab = rt_str_concat(a, b);
    let result = rt_str_concat(ab, c);
    rt_str_free(ab);
    return result;
}

// ============================================================================
// Split / join with delimiter (Session 107, S01)
// ============================================================================
//
// `str_split(s, delim) -> Vec<Str>` splits `s` on every occurrence of
// `delim` and returns a NEW Vec owning fresh heap strings, one per part.
// Contract (deterministic, documented):
//   - empty parts are preserved: `"a,"` with `","` -> ["a", ""];
//   - no occurrence: the whole input is one part;
//   - empty `s`: one empty part (`""` -> [""]);
//   - empty `delim`: no split, the whole input is one part;
//   - `delim` longer than `s`: the whole input is one part.
// The caller owns the returned Vec and frees it with `rt_vec_free` (which
// frees every contained string). `s` and `delim` are consumed.

fn str_split(s: Str, delim: Str) -> Vec<Str> {
    let slen = rt_str_len(s);
    let dlen = rt_str_len(delim);
    // Count parts = occurrences + 1 (1 when delim is empty or absent).
    let mut count = 0;
    if dlen > 0 {
        if dlen <= slen {
            let mut pos = 0;
            while pos <= slen - dlen {
                let mut mf = true;
                let mut j = 0;
                while j < dlen {
                    if rt_str_byte(s, pos + j) != rt_str_byte(delim, j) {
                        mf = false;
                        j = dlen;
                    } else {
                        j = j + 1;
                    }
                }
                if mf {
                    count = count + 1;
                    pos = pos + dlen;
                }
                if !mf {
                    pos = pos + 1;
                }
            }
        }
    }
    let mut parts = count + 1;
    let mut v = rt_vec_new(parts);
    // Extract each part into a fresh heap string and push it.
    let mut start = 0;
    let mut pi = 0;
    while pi < parts {
        // Find the next occurrence at or after `start`; default = end.
        let mut occ = slen;
        if dlen > 0 {
            let mut p = start;
            let mut done = 0;
            while p <= slen - dlen && done == 0 {
                let mut mf = true;
                let mut j = 0;
                while j < dlen {
                    if rt_str_byte(s, p + j) != rt_str_byte(delim, j) {
                        mf = false;
                        j = dlen;
                    } else {
                        j = j + 1;
                    }
                }
                if mf {
                    done = 1;
                }
                if done == 0 {
                    p = p + 1;
                }
            }
            if done == 1 {
                occ = p;
            }
        }
        let plen = occ - start;
        let part = rt_str_alloc(plen);
        let mut k = 0;
        while k < plen {
            rt_str_set_byte(part, k, rt_str_byte(s, start + k));
            k = k + 1;
        }
        v = rt_vec_push(v, part);
        pi = pi + 1;
        start = occ + dlen;
    }
    rt_str_free(s);
    rt_str_free(delim);
    return v;
}

// `str_join(parts: Vec<Str>, delim: Str) -> Str` joins every element of
// `parts` with `delim` between consecutive elements. An empty Vec yields
// the empty string. The Vec (and every contained string) is consumed and
// freed by this function; `delim` is consumed.

fn str_join(parts: Vec<Str>, delim: Str) -> Str {
    let n = rt_vec_len(parts);
    let dlen = rt_str_len(delim);
    let mut total = 0;
    let mut i = 0;
    while i < n {
        total = total + rt_str_len(rt_vec_get(parts, i));
        i = i + 1;
    }
    if n > 0 {
        total = total + dlen * (n - 1);
    }
    let out = rt_str_alloc(total);
    let mut o = 0;
    let mut i2 = 0;
    while i2 < n {
        let part = rt_vec_get(parts, i2);
        let plen = rt_str_len(part);
        let mut k = 0;
        while k < plen {
            rt_str_set_byte(out, o, rt_str_byte(part, k));
            o = o + 1;
            k = k + 1;
        }
        if i2 < n - 1 {
            let mut d = 0;
            while d < dlen {
                rt_str_set_byte(out, o, rt_str_byte(delim, d));
                o = o + 1;
                d = d + 1;
            }
        }
        i2 = i2 + 1;
    }
    rt_str_free(delim);
    rt_vec_free(parts);
    return out;
}

// ============================================================================
// Char at position — returns byte value
// ============================================================================

fn str_char_at(s: Str, index: Int) -> (Int, Str) {
    return (rt_str_byte(s, index), s);
}

// ============================================================================
// String → number parsing (Session 108, S06)
// ============================================================================
// Python's `int()`/`float()` raise ValueError on malformed input. MINK has no
// exceptions, so each parser returns a `(value, ok)` tuple instead: `ok` is
// the "the text was a valid number" flag, and `value` is 0 when `ok` is
// false. This mirrors MINK's existing tuple-result idiom (`str_char_at`,
// the JSON parsers) and its INTENT. DIFF. error model.
//
// Accepted grammar (ASCII whitespace, matching the common Python cases):
//   int:   [ws] [+|-] digits-with-optional-'_'-separators [ws]
//   float: [ws] [+|-] digits [ '.' digits ] [ ('e'|'E') [+|-] digits ] [ws]
// At least one digit is required; a sign, a bare '.', a bare exponent, and
// trailing junk all report `ok = false`.

/// Internal: ASCII whitespace test (space, tab, LF, VT, FF, CR).
fn str_is_space(b: Int) -> Bool {
    let mut r = false;
    if b == 32 { r = true; }
    if b == 9 { r = true; }
    if b == 10 { r = true; }
    if b == 11 { r = true; }
    if b == 12 { r = true; }
    if b == 13 { r = true; }
    return r;
}

/// str_parse_int(s): parse a decimal integer. `(value, true)` on success,
/// `(0, false)` otherwise. Consumes `s`. Magnitudes beyond the 64-bit
/// signed range report `ok = false`.
fn str_parse_int(s: Str) -> (Int, Bool) {
    let n = rt_str_len(s);
    let mut i = 0;
    while i < n {
        if str_is_space(rt_str_byte(s, i)) { i = i + 1; } else { break; }
    }
    let mut neg = 1;
    if i < n {
        let sign = rt_str_byte(s, i);
        if sign == 45 { neg = 0 - 1; i = i + 1; }
        if sign == 43 { i = i + 1; }
    }
    let mut value = 0;
    let mut digits = 0;
    let mut overflow = 0;
    let mut prev_digit = 0;
    while i < n {
        let b = rt_str_byte(s, i);
        if b == 95 {
            // '_' is a separator only between digits (Python 3.6+).
            if prev_digit == 1 {
                prev_digit = 0;
                i = i + 1;
            } else {
                break;
            }
        } else {
            if b >= 48 {
                if b <= 57 {
                    let d = b - 48;
                    if value > 922337203685477580 { overflow = 1; }
                    if value == 922337203685477580 {
                        // i64::MAX ends in 7; i64::MIN's magnitude ends in 8.
                        let mut limit = 7;
                        if neg == -1 { limit = 8; }
                        if d > limit { overflow = 1; }
                    }
                    value = value * 10 + d;
                    digits = digits + 1;
                    prev_digit = 1;
                    i = i + 1;
                } else {
                    break;
                }
            } else {
                break;
            }
        }
    }
    let mut junk = 0;
    while i < n {
        if str_is_space(rt_str_byte(s, i)) { i = i + 1; } else { junk = 1; break; }
    }
    let mut ok = true;
    if digits == 0 { ok = false; }
    if prev_digit == 0 { ok = false; }
    if overflow == 1 { ok = false; }
    if junk == 1 { ok = false; }
    let mut result = value;
    if neg == -1 { result = 0 - value; }
    if ok == false { result = 0; }
    rt_str_free(s);
    return (result, ok);
}

/// str_parse_float(s): parse a decimal floating-point number with an
/// optional fraction and exponent. `(value, true)` on success,
/// `(0.0, false)` otherwise. Consumes `s`.
///
/// The result is assembled with Float arithmetic (`int + frac/10^k` scaled
/// by `10^exp`), so very long fractions/exponents lose low-order precision;
/// this is capability parity, not bit-exact `strtod`.
fn str_parse_float(s: Str) -> (Float, Bool) {
    let n = rt_str_len(s);
    let mut i = 0;
    while i < n {
        if str_is_space(rt_str_byte(s, i)) { i = i + 1; } else { break; }
    }
    let mut neg = 1;
    if i < n {
        let sign = rt_str_byte(s, i);
        if sign == 45 { neg = 0 - 1; i = i + 1; }
        if sign == 43 { i = i + 1; }
    }
    let mut int_digits = 0;
    let mut int_val = 0;
    while i < n {
        let b = rt_str_byte(s, i);
        if b >= 48 {
            if b <= 57 {
                int_val = int_val * 10 + (b - 48);
                int_digits = int_digits + 1;
                i = i + 1;
            } else {
                break;
            }
        } else {
            break;
        }
    }
    let mut frac_digits = 0;
    let mut frac_val = 0;
    if i < n {
        if rt_str_byte(s, i) == 46 {
            i = i + 1;
            while i < n {
                let b = rt_str_byte(s, i);
                if b >= 48 {
                    if b <= 57 {
                        frac_val = frac_val * 10 + (b - 48);
                        frac_digits = frac_digits + 1;
                        i = i + 1;
                    } else {
                        break;
                    }
                } else {
                    break;
                }
            }
        }
    }
    let mut exp_val = 0;
    let mut exp_digits = 0;
    let mut exp_neg = 1;
    let mut has_exp = 0;
    if i < n {
        let e = rt_str_byte(s, i);
        if e == 101 {
            has_exp = 1;
        }
        if e == 69 {
            has_exp = 1;
        }
        if has_exp == 1 {
            i = i + 1;
            if i < n {
                let sign = rt_str_byte(s, i);
                if sign == 45 { exp_neg = 0 - 1; i = i + 1; }
                if sign == 43 { i = i + 1; }
            }
            while i < n {
                let b = rt_str_byte(s, i);
                if b >= 48 {
                    if b <= 57 {
                        exp_val = exp_val * 10 + (b - 48);
                        exp_digits = exp_digits + 1;
                        i = i + 1;
                    } else {
                        break;
                    }
                } else {
                    break;
                }
            }
        }
    }
    let mut junk = 0;
    while i < n {
        if str_is_space(rt_str_byte(s, i)) { i = i + 1; } else { junk = 1; break; }
    }
    let mut value = rt_int_to_float(int_val);
    if frac_digits > 0 {
        let mut scale = 1.0;
        let mut k = 0;
        while k < frac_digits {
            scale = scale * 10.0;
            k = k + 1;
        }
        value = value + rt_int_to_float(frac_val) / scale;
    }
    // Clamp the exponent so a pathological input such as "1e999999999"
    // converges to 0/inf instead of spinning; 400 iterations already
    // over/underflows f64.
    if exp_val > 400 { exp_val = 400; }
    let mut k2 = 0;
    while k2 < exp_val {
        if exp_neg == 1 { value = value * 10.0; } else { value = value / 10.0; }
        k2 = k2 + 1;
    }
    if neg == -1 { value = 0.0 - value; }
    let mut ok = true;
    if int_digits + frac_digits == 0 { ok = false; }
    if has_exp == 1 {
        if exp_digits == 0 { ok = false; }
    }
    if junk == 1 { ok = false; }
    if ok == false { value = 0.0; }
    rt_str_free(s);
    return (value, ok);
}

