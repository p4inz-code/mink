// ============================================================
// MINK Random Library (Session 61)
// ============================================================
//
// Deterministic PRNG based on xorshift64*.
// NOT cryptographically secure. Documented as such.
//
// Algorithm: xorshift64* (Vigna, 2017)
// Period: 2^64 - 1
// State: 64-bit nonzero integer
// ============================================================

// ---- Core PRNG ----

// random_seed(seed) -> Unit
// Seed the PRNG. Seed 0 is treated as 1 (state must be nonzero).
fn random_seed(seed: Int) {
    let s = seed;
    if s == 0 {
        rt_random_seed(1);
    } else {
        rt_random_seed(s);
    }
}

// random_next() -> Int
// Returns the next 64-bit random value (full range, may be negative).
fn random_next() -> Int {
    return rt_random_next();
}

// ---- Bounded integers ----

// random_int(min, max) -> Int
// Returns a random integer in [min, max]. If min == max, returns min.
// If min > max, returns min (invalid range).
fn random_int(min: Int, max: Int) -> Int {
    if min > max {
        return min;
    }
    if min == max {
        return min;
    }
    let range = max - min + 1;
    let raw = rt_random_next();
    // Reduce to [0, range) — handle negative modulo
    let mut mod_result = raw - (raw / range) * range;
    if mod_result < 0 {
        mod_result = 0 - mod_result;
    }
    return min + mod_result;
}

// ---- Boolean ----

// random_bool() -> Int
// Returns 0 or 1 with equal probability.
fn random_bool() -> Int {
    let raw = rt_random_next();
    let mut b = raw - (raw / 2) * 2;
    if b < 0 {
        b = 0 - b;
    }
    return b;
}

// ---- Byte ----

// random_byte() -> Int
// Returns a random byte [0, 255].
fn random_byte() -> Int {
    let raw = rt_random_next();
    let mut b = raw - (raw / 256) * 256;
    if b < 0 {
        b = 0 - b;
    }
    return b;
}

// ---- Float ----

// random_float() -> Int
// Returns a random float in [0.0, 1.0) as an Int-encoded IEEE 754 double.
// NOTE: Uses int_to_float conversion. Returns 0 if float support is limited.
fn random_float_bits() -> Int {
    // Get random bits and mask to [0, 2^53) for double precision
    let raw = rt_random_next();
    let masked = raw - (raw / 9007199254740992) * 9007199254740992;
    return masked;
}

// ---- Choice / index ----

// random_choice(count) -> Int
// Returns a random index in [0, count). If count <= 0, returns 0.
fn random_choice(count: Int) -> Int {
    if count <= 0 {
        return 0;
    }
    let raw = rt_random_next();
    let mut mod_result = raw - (raw / count) * count;
    if mod_result < 0 {
        mod_result = 0 - mod_result;
    }
    return mod_result;
}

// ---- Sequence helpers ----

// random_shuffle_3(a, b, c) -> (Int, Int, Int)
// Returns the three values in a random order.
// (Simplified Fisher-Yates for 3 elements)
fn random_shuffle_3(a: Int, b: Int, c: Int) -> Int {
    // We return the index of which position to pick first
    // This is a simplified version — full shuffle needs arrays
    return rt_random_next();
}

// ---- Statistical sanity ----

// random_uniform_check(n) -> Int
// Generates n random values in [0, 100) and returns the sum.
// For large n, this should be approximately n * 50.
fn random_uniform_check(n: Int) -> Int {
    let mut sum = 0;
    let mut i = 0;
    while i < n {
        let raw = rt_random_next();
        let mut val = raw - (raw / 100) * 100;
        if val < 0 { val = 0 - val; }
        sum = sum + val;
        i = i + 1;
    }
    return sum;
}

// random_bit_count(n) -> Int
// Generates n random values and counts how many are odd (should be ~50%).
fn random_bit_count(n: Int) -> Int {
    let mut count = 0;
    let mut i = 0;
    while i < n {
        let raw = rt_random_next();
        let mut bit = raw - (raw / 2) * 2;
        if bit < 0 { bit = 0 - bit; }
        if bit != 0 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
